<Window x:Class="KCD2SaveEditor.UI.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:vm="clr-namespace:KCD2SaveEditor.UI.ViewModels"

        xmlns:conv="clr-namespace:KCD2SaveEditor.UI.Converters"

        xmlns:services="clr-namespace:KCD2SaveEditor.UI.Services"

        mc:Ignorable="d"

        Title="KCD II // SAVE EDITOR v2.5.0" 

        Height="940" Width="1540"

        MinHeight="780" MinWidth="1240"

        WindowStartupLocation="CenterScreen"

        WindowState="Maximized"

        WindowStyle="None"

        AllowDrop="True" Drop="MainWindow_Drop" DragOver="MainWindow_DragOver"

        Background="#090B0F" Foreground="#E2E8F0">



    <WindowChrome.WindowChrome>

        <WindowChrome CaptionHeight="34"

                      ResizeBorderThickness="6"

                      CornerRadius="0"

                      GlassFrameThickness="0"

                      UseAeroCaptionButtons="False" />

    </WindowChrome.WindowChrome>



    <Window.DataContext>

        <vm:MainViewModel />

    </Window.DataContext>



    <Window.Resources>

        <!-- Converters -->

        <conv:EqualityToVisibilityConverter x:Key="EqToVis" />

        <conv:EqualityToBrushConverter x:Key="EqToBrush" />

        <conv:EqualityToForegroundConverter x:Key="EqToFg" />

        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

        <conv:IntGreaterThanZeroToVisibilityConverter x:Key="IntGtZeroToVis" />



        <!-- Pill RadioButton Style -->

        <Style x:Key="PillRadioButton" TargetType="RadioButton">

            <Setter Property="Background" Value="#141822"/>

            <Setter Property="BorderBrush" Value="#25FFFFFF"/>

            <Setter Property="Foreground" Value="#94A3B8"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Padding" Value="8,4"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#1C2333"/>

                                <Setter TargetName="bd" Property="BorderBrush" Value="#C9A24D"/>

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#2A2212"/>

                                <Setter TargetName="bd" Property="BorderBrush" Value="#E5C478"/>

                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>

                                <Setter Property="Foreground" Value="#E5C478"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Brand Colors -->

        <Color x:Key="KcdBg">#090B0F</Color>

        <Color x:Key="KcdPanel">#12151C</Color>

        <Color x:Key="KcdCard">#171B24</Color>

        <Color x:Key="KcdGold">#C9A24D</Color>

        <Color x:Key="KcdGoldLight">#E5C478</Color>

        <Color x:Key="KcdCrimson">#8C1D24</Color>

        <Color x:Key="KcdBorder">#262C3A</Color>



        <SolidColorBrush x:Key="KcdGoldBrush" Color="{StaticResource KcdGold}" />

        <SolidColorBrush x:Key="KcdGoldLightBrush" Color="{StaticResource KcdGoldLight}" />

        <SolidColorBrush x:Key="KcdPanelBrush" Color="{StaticResource KcdPanel}" />

        <SolidColorBrush x:Key="KcdCardBrush" Color="{StaticResource KcdCard}" />

        <SolidColorBrush x:Key="KcdBorderBrush" Color="{StaticResource KcdBorder}" />



        <!-- Gold Button Style -->

        <Style x:Key="GoldButton" TargetType="Button">

            <Setter Property="Background">

                <Setter.Value>

                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                        <GradientStop Color="#D8B467" Offset="0"/>

                        <GradientStop Color="#A98032" Offset="1"/>

                    </LinearGradientBrush>

                </Setter.Value>

            </Setter>

            <Setter Property="Foreground" Value="#0D1017"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Padding" Value="14,6"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Dark Utility Button Style -->

        <Style x:Key="DarkUtilityButton" TargetType="Button">

            <Setter Property="Background" Value="#171C26"/>

            <Setter Property="Foreground" Value="#E2E8F0"/>

            <Setter Property="BorderBrush" Value="#2A2F40"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="10,5"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#1F2633"/>

                                <Setter TargetName="bd" Property="BorderBrush" Value="#C9A24D"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SecondarySmallButton" TargetType="Button" BasedOn="{StaticResource DarkUtilityButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>



        <!-- Crimson Button Style -->

        <Style x:Key="CrimsonButton" TargetType="Button">

            <Setter Property="Background" Value="#8C1D24"/>

            <Setter Property="Foreground" Value="#FFFFFF"/>

            <Setter Property="BorderBrush" Value="#C9A24D"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="12,5"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#B92B34"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Window Control Button Style -->

        <Style x:Key="WindowControlButton" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#94A3B8"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Width" Value="46"/>

            <Setter Property="Height" Value="34"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd" Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#1E2430"/>

                                <Setter Property="Foreground" Value="#E5C478"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#2A2212"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Window Close Button Style -->

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd" Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#B92B34"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#8C1D24"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Custom Slider Style matching KCD Prototype -->

        <Style TargetType="Slider">

            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#E5C478"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Slider">

                        <Grid VerticalAlignment="Center">

                            <Track x:Name="PART_Track">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">

                                        <RepeatButton.Template>

                                            <ControlTemplate TargetType="RepeatButton">

                                                <Border Height="5" CornerRadius="2.5" Background="#C9A24D" />

                                            </ControlTemplate>

                                        </RepeatButton.Template>

                                    </RepeatButton>

                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">

                                        <RepeatButton.Template>

                                            <ControlTemplate TargetType="RepeatButton">

                                                <Border Height="5" CornerRadius="2.5" Background="#232936" />

                                            </ControlTemplate>

                                        </RepeatButton.Template>

                                    </RepeatButton>

                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Ellipse Width="14" Height="14" Fill="#E5C478" Stroke="#12151C" StrokeThickness="2" Cursor="Hand">

                                                    <Ellipse.Effect>

                                                        <DropShadowEffect Color="#C9A24D" BlurRadius="6" ShadowDepth="0" Opacity="0.7"/>

                                                    </Ellipse.Effect>

                                                </Ellipse>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Custom Dark ScrollBar Style -->

        <Style TargetType="ScrollBar">

            <Setter Property="Background" Value="#0D1016"/>

            <Setter Property="Foreground" Value="#283040"/>

            <Setter Property="Width" Value="6"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="{TemplateBinding Background}">

                            <Track x:Name="PART_Track" IsDirectionReversed="true">

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Border Background="{TemplateBinding Foreground}" CornerRadius="3" />

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Foreground" Value="#C9A24D"/>

                </Trigger>

            </Style.Triggers>

        </Style>



        <!-- Custom Dark TextBox Style -->

        <Style TargetType="TextBox">

            <Setter Property="Background" Value="#0B0E14"/>

            <Setter Property="Foreground" Value="#F1F5F9"/>

            <Setter Property="BorderBrush" Value="#2A2F40"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="6,4"/>

            <Setter Property="CaretBrush" Value="#E5C478"/>

            <Setter Property="SelectionBrush" Value="#C9A24D"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">

                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsFocused" Value="True">

                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A24D"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Custom ComboBox Toggle Button Template -->

        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition />

                    <ColumnDefinition Width="26" />

                </Grid.ColumnDefinitions>

                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"

                        Background="{TemplateBinding Background}"

                        BorderBrush="{TemplateBinding BorderBrush}"

                        BorderThickness="{TemplateBinding BorderThickness}" />

                <Border Grid.Column="0" Background="Transparent" />

                <!-- Dropdown Arrow -->

                <Path x:Name="Arrow" Grid.Column="1"

                      HorizontalAlignment="Center" VerticalAlignment="Center"

                      Data="M 0 0 L 4.5 4.5 L 9 0 Z"

                      Fill="#C9A24D" />

            </Grid>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter TargetName="Border" Property="Background" Value="#1C2331" />

                    <Setter TargetName="Border" Property="BorderBrush" Value="#C9A24D" />

                    <Setter TargetName="Arrow" Property="Fill" Value="#E5C478" />

                </Trigger>

                <Trigger Property="IsChecked" Value="True">

                    <Setter TargetName="Border" Property="Background" Value="#161B24" />

                    <Setter TargetName="Border" Property="BorderBrush" Value="#E5C478" />

                    <Setter TargetName="Arrow" Property="Fill" Value="#E5C478" />

                </Trigger>

                <Trigger Property="IsEnabled" Value="False">

                    <Setter TargetName="Border" Property="Opacity" Value="0.4" />

                    <Setter TargetName="Arrow" Property="Fill" Value="#64748B" />

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>



        <!-- Global Dark ComboBox Style (High Contrast) -->

        <Style TargetType="ComboBox">

            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>

            <Setter Property="MinHeight" Value="30"/>

            <Setter Property="Foreground" Value="#F1F5F9"/>

            <Setter Property="Background" Value="#141821"/>

            <Setter Property="BorderBrush" Value="#2A2F40"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid SnapsToDevicePixels="True">

                            <ToggleButton Name="ToggleButton"

                                          Template="{StaticResource DarkComboBoxToggleButton}"

                                          Focusable="False"

                                          ClickMode="Press"

                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"

                                          Background="{TemplateBinding Background}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          BorderThickness="{TemplateBinding BorderThickness}"/>

                            

                            <ContentPresenter Name="ContentSite"

                                              IsHitTestVisible="False"

                                              Content="{TemplateBinding SelectionBoxItem}"

                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"

                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"

                                              Margin="10,4,28,4"

                                              VerticalAlignment="Center"

                                              HorizontalAlignment="Left" />

                            

                            <!-- Dark Popup with Gold Border and Shadow -->

                            <Popup Name="Popup"

                                   Placement="Bottom"

                                   IsOpen="{TemplateBinding IsDropDownOpen}"

                                   AllowsTransparency="True"

                                   Focusable="False"

                                   PopupAnimation="Slide">

                                <Grid Name="DropDown"

                                      SnapsToDevicePixels="True"

                                      MinWidth="{TemplateBinding ActualWidth}"

                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                    <Border x:Name="DropDownBorder"

                                            Background="#12151C"

                                            BorderBrush="#C9A24D"

                                            BorderThickness="1"

                                            CornerRadius="6"

                                            Margin="0,3,0,6">

                                        <Border.Effect>

                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="6" Opacity="0.85"/>

                                        </Border.Effect>

                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">

                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />

                                        </ScrollViewer>

                                    </Border>

                                </Grid>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="HasItems" Value="False">

                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="BorderBrush" Value="#C9A24D"/>

                            </Trigger>

                            <Trigger Property="IsFocused" Value="True">

                                <Setter Property="BorderBrush" Value="#E5C478"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Global Dark ComboBoxItem Style (High Contrast) -->

        <Style TargetType="ComboBoxItem">

            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="Foreground" Value="#E2E8F0"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderBrush" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="3,0,0,0"/>

            <Setter Property="Padding" Value="10,7"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="Border"

                                Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                Padding="{TemplateBinding Padding}"

                                SnapsToDevicePixels="True">

                            <ContentPresenter VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#1C2331"/>

                                <Setter TargetName="Border" Property="BorderBrush" Value="#C9A24D"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="Border" Property="Background" Value="#292113"/>

                                <Setter TargetName="Border" Property="BorderBrush" Value="#E5C478"/>

                                <Setter Property="Foreground" Value="#E5C478"/>

                                <Setter Property="FontWeight" Value="Bold"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- ================================================================= -->

        <!-- V2 TOP RIBBON NAVIGATION TAB BUTTON STYLES                        -->

        <!-- ================================================================= -->

        <Style x:Key="MainNavTabButton" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#94A3B8"/>

            <Setter Property="BorderThickness" Value="0,0,0,2"/>

            <Setter Property="BorderBrush" Value="Transparent"/>

            <Setter Property="Padding" Value="24,10"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#151A24"/>

                                <Setter Property="Foreground" Value="#E5C478"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="NavTabQuestlogStyle" TargetType="Button" BasedOn="{StaticResource MainNavTabButton}">

            <Style.Triggers>

                <DataTrigger Binding="{Binding SelectedMainTab}" Value="Questlog">

                    <Setter Property="Foreground" Value="#F6E05E"/>

                    <Setter Property="BorderBrush" Value="#C9A24D"/>

                    <Setter Property="Background">

                        <Setter.Value>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                                <GradientStop Color="#35C9A24D" Offset="0"/>

                                <GradientStop Color="#08C9A24D" Offset="1"/>

                            </LinearGradientBrush>

                        </Setter.Value>

                    </Setter>

                </DataTrigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="NavTabInventarStyle" TargetType="Button" BasedOn="{StaticResource MainNavTabButton}">

            <Style.Triggers>

                <DataTrigger Binding="{Binding SelectedMainTab}" Value="Inventar">

                    <Setter Property="Foreground" Value="#F6E05E"/>

                    <Setter Property="BorderBrush" Value="#C9A24D"/>

                    <Setter Property="Background">

                        <Setter.Value>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                                <GradientStop Color="#35C9A24D" Offset="0"/>

                                <GradientStop Color="#08C9A24D" Offset="1"/>

                            </LinearGradientBrush>

                        </Setter.Value>

                    </Setter>

                </DataTrigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="NavTabSpielerStyle" TargetType="Button" BasedOn="{StaticResource MainNavTabButton}">

            <Style.Triggers>

                <DataTrigger Binding="{Binding SelectedMainTab}" Value="Spieler">

                    <Setter Property="Foreground" Value="#F6E05E"/>

                    <Setter Property="BorderBrush" Value="#C9A24D"/>

                    <Setter Property="Background">

                        <Setter.Value>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                                <GradientStop Color="#35C9A24D" Offset="0"/>

                                <GradientStop Color="#08C9A24D" Offset="1"/>

                            </LinearGradientBrush>

                        </Setter.Value>

                    </Setter>

                </DataTrigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="NavTabHandwerkStyle" TargetType="Button" BasedOn="{StaticResource MainNavTabButton}">

            <Style.Triggers>

                <DataTrigger Binding="{Binding SelectedMainTab}" Value="Handwerk">

                    <Setter Property="Foreground" Value="#F6E05E"/>

                    <Setter Property="BorderBrush" Value="#C9A24D"/>

                    <Setter Property="Background">

                        <Setter.Value>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                                <GradientStop Color="#35C9A24D" Offset="0"/>

                                <GradientStop Color="#08C9A24D" Offset="1"/>

                            </LinearGradientBrush>

                        </Setter.Value>

                    </Setter>

                </DataTrigger>

            </Style.Triggers>

        </Style>



        <!-- Target Switcher Styles (Heinrich vs Pebbles) -->

        <Style x:Key="TargetToggleHenryButton" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#94A3B8"/>

            <Setter Property="Padding" Value="10,4"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="FontSize" Value="11"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <DataTrigger Binding="{Binding SelectedInventoryTarget}" Value="Henry">

                    <Setter Property="Background" Value="#C9A24D"/>

                    <Setter Property="Foreground" Value="#0D1017"/>

                    <Setter Property="FontWeight" Value="Bold"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="TargetToggleHorseButton" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

