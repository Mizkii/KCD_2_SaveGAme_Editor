                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- Square Box -->

                            <Border x:Name="CheckBd" Grid.Column="0" Width="18" Height="18" CornerRadius="4"

                                    Background="#0D1118" BorderBrush="#3B4252" BorderThickness="1.5"

                                    Margin="0,0,8,0" VerticalAlignment="Center">

                                <Path x:Name="CheckMark" Data="M 3 9 L 7 13 L 14 5"

                                      Stroke="#0D1017" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"

                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>

                            </Border>

                            <!-- Content Label -->

                            <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="CheckBd" Property="Background" Value="#C9A24D"/>

                                <Setter TargetName="CheckBd" Property="BorderBrush" Value="#F6E05E"/>

                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="CheckBd" Property="BorderBrush" Value="#E5C478"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

