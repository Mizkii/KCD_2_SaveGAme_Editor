                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,2">
                                            <TextBlock Text="{Binding Loc_Unarmed}" FontSize="10" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding WeaponUnarmedAttack}" Width="30" TextAlignment="Right" Foreground="#CBD5E1"/>
                                                <TextBlock Text="0" Width="30" TextAlignment="Right" Foreground="#64748B"/>
                                                <TextBlock Text="0" Width="35" TextAlignment="Right" Foreground="#64748B"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>

                                </Border>



                                <!-- Right Sub-Column: INTERACTIVE ATTRIBUTE SLIDERS (2 COLUMNS) -->

                                <Border Grid.Column="2" Background="#141923" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="6" />

                                            <ColumnDefinition Width="*" />

                                        </Grid.ColumnDefinitions>



                                        <!-- Col 1: Stärke, Agilität, Vitalität, Redekunst, Charisma, Geschw. -->

                                        <StackPanel Grid.Column="0">

                                            <!-- Stärke -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Strength}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding Strength}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Strength}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Agilität -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Agility}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding Agility}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Agility}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Vitalität -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Vitality}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding Vitality}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Vitality}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Redekunst -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Speech}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding Speech}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Speech}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Charisma -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Charisma}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding Charisma}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Charisma}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Geschwindigkeit -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Speed}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding Speed}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Speed}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                        </StackPanel>



                                        <!-- Col 2: Auffälligkeit, Geräusche, Sichtbarkeit, Gesundheit, Ausdauer, Energie -->

                                        <StackPanel Grid.Column="2">

                                            <!-- Auffälligkeit -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Conspicuousness}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Conspicuousness}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Conspicuousness}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Geräusche -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Noise}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Noise}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Noise}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Sichtbarkeit -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Visibility}" FontSize="10" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Visibility}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Visibility}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Gesundheit -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Health}" FontSize="10" Foreground="#4ADE80" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Health}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Health, StringFormat='{}{0:0}'}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Ausdauer -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Stamina}" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Stamina}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Stamina, StringFormat='{}{0:0}'}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                            <!-- Energie -->

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Loc_Energy}" FontSize="10" Foreground="#FCD34D" VerticalAlignment="Center"/>

                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Energy}" VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2" Text="{Binding Energy, StringFormat='{}{0:0}'}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextAlignment="Center" Padding="0,1"/>

                                            </Grid>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </ScrollViewer>



                    <!-- TARGET VIEW 2: SCHIMMEL (PEBBLES) REITTIER & SATTELTASCHEN -->

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"

                                  Visibility="{Binding SelectedInventoryTarget, Converter={StaticResource EqToVis}, ConverterParameter='Pebbles'}" Padding="10">

                        <StackPanel>

                            <!-- Horse Profile Card -->

                            <Border Background="#151A24" BorderBrush="#40C9A24D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#40854D0E" BorderBrush="#80C9A24D" BorderThickness="1" Margin="0,0,12,0">

                                        <TextBlock Text="🐎" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding Loc_SelectHorseLabel}" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,0,0,3"/>

                                        <ComboBox Grid.Row="1" ItemsSource="{Binding AvailableHorses}" SelectedItem="{Binding SelectedHorseOption, Mode=TwoWay}"

                                                  Background="#161B26" Foreground="#F6E05E" BorderBrush="#50C9A24D" BorderThickness="1" Padding="6,4"

                                                  FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch">

                                            <ComboBox.ItemTemplate>

                                                <DataTemplate DataType="{x:Type vm:HorseOptionViewModel}">

                                                    <Grid Margin="0,2">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="Auto"/>

                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">

                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>

                                                            <TextBlock Text="{Binding DisplayBreed}" Foreground="#94A3B8" FontSize="10"/>

                                                        </StackPanel>

                                                        <Border Grid.Column="1" Background="#25C9A24D" BorderBrush="#60C9A24D" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">

                                                            <TextBlock Text="{Binding TierDisplay}" Foreground="#F6E05E" FontSize="9" FontWeight="Bold"/>

                                                        </Border>

                                                    </Grid>

                                                </DataTemplate>

                                            </ComboBox.ItemTemplate>

                                        </ComboBox>

                                    </Grid>

                                    <Button Grid.Column="2" Command="{Binding MaxHorseStatsCommand}" Style="{StaticResource DarkUtilityButton}" ToolTip="{Binding Loc_MaxHorseStatsTip}">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="⚡ " Foreground="#FCD34D"/>

                                            <TextBlock Text="{Binding Loc_MaxHorseStatsBtn}" FontWeight="Bold"/>

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Border>



                            <!-- 4 Horse Tack Slots -->

                            <!-- Horse Tack Presets Control Bar (OUTFIT I, II, III) -->
                            <Border Background="#151A24" BorderBrush="#40C9A24D" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Active Tack Title & Badge -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🐎" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentHorseOutfitTitle}" FontSize="11" FontWeight="Bold" Foreground="#E5C478" VerticalAlignment="Center"/>
                                            <Border Background="#25C9A24D" BorderBrush="#50C9A24D" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentHorseOutfitBadge}" FontSize="9" FontWeight="Bold" Foreground="#F6E05E"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right: Preset Buttons I, II, III -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Loc_HorseTackLabel}" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- Tack 1 (Warhorse) -->
                                        <Button Command="{Binding SwitchHorseOutfitCommand}" CommandParameter="1" Margin="0,0,4,0" Width="28" Height="28" Cursor="Hand" ToolTip="{Binding Loc_HorseTackWarhorseTip}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdr" CornerRadius="5" Background="#101A14" BorderBrush="#20402F" BorderThickness="1" Opacity="0.55">
                                                        <TextBlock x:Name="txt" Text="I" FontWeight="Bold" FontSize="11" Foreground="#4A7C5E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveHorseOutfit}" Value="1">
                                                            <Setter TargetName="bdr" Property="Background" Value="#1B4D36"/>
                                                            <Setter TargetName="bdr" Property="BorderBrush" Value="#4ADE80"/>
                                                            <Setter TargetName="bdr" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="bdr" Property="Opacity" Value="1.0"/>
                                                            <Setter TargetName="txt" Property="Foreground" Value="#86EFAC"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bdr" Property="Opacity" Value="1.0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Tack 2 (Travel & Speed) -->
                                        <Button Command="{Binding SwitchHorseOutfitCommand}" CommandParameter="2" Margin="0,0,4,0" Width="28" Height="28" Cursor="Hand" ToolTip="{Binding Loc_HorseTackTravelTip}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdr" CornerRadius="5" Background="#19150E" BorderBrush="#3B2E17" BorderThickness="1" Opacity="0.55">
                                                        <TextBlock x:Name="txt" Text="II" FontWeight="Bold" FontSize="11" Foreground="#7C6843" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveHorseOutfit}" Value="2">
                                                            <Setter TargetName="bdr" Property="Background" Value="#452709"/>
                                                            <Setter TargetName="bdr" Property="BorderBrush" Value="#FBBF24"/>
                                                            <Setter TargetName="bdr" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="bdr" Property="Opacity" Value="1.0"/>
                                                            <Setter TargetName="txt" Property="Foreground" Value="#FDE68A"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bdr" Property="Opacity" Value="1.0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Tack 3 (Noble Courser) -->
                                        <Button Command="{Binding SwitchHorseOutfitCommand}" CommandParameter="3" Width="28" Height="28" Cursor="Hand" ToolTip="{Binding Loc_HorseTackNobleTip}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdr" CornerRadius="5" Background="#1A1014" BorderBrush="#3B1822" BorderThickness="1" Opacity="0.55">
                                                        <TextBlock x:Name="txt" Text="III" FontWeight="Bold" FontSize="11" Foreground="#7D4653" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveHorseOutfit}" Value="3">
                                                            <Setter TargetName="bdr" Property="Background" Value="#4C0D1B"/>
                                                            <Setter TargetName="bdr" Property="BorderBrush" Value="#FB7185"/>
                                                            <Setter TargetName="bdr" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="bdr" Property="Opacity" Value="1.0"/>
                                                            <Setter TargetName="txt" Property="Foreground" Value="#FECDD3"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bdr" Property="Opacity" Value="1.0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Interactive Horse Equipment Slots (Clickable to open selector modal) -->
                            <ItemsControl ItemsSource="{Binding HorseEquipmentSlots}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PaperdollSlotViewModel}">
                                        <Button Command="{Binding ClickCommand}" Margin="3" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="slotBorder" CornerRadius="6" Background="#141822" BorderBrush="#35FFFFFF" BorderThickness="1" Padding="8,6" MinHeight="48">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icon -->
                                                            <Border Grid.Column="0" Width="30" Height="30" Background="#182030" BorderBrush="#40C9A24D" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Label & Equipped Name -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DefaultLabel}" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Consolas"/>
                                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                            </StackPanel>

                                                            <!-- Edit cue arrow -->
                                                            <TextBlock Grid.Column="2" Text="⚙" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="slotBorder" Property="BorderBrush" Value="#E5C478"/>
                                                            <Setter TargetName="slotBorder" Property="Background" Value="#1A2030"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="slotBorder" Property="BorderBrush" Value="#F6E05E"/>
                                                            <Setter TargetName="slotBorder" Property="BorderThickness" Value="1.5"/>
                                                            <Setter TargetName="slotBorder" Property="Background" Value="#252015"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>



                            <!-- Horse Interactive Stats Sliders -->

                            <Border Background="#141923" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">

                                <StackPanel>

                                    <Grid Margin="0,0,0,8">

                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc_HorseSpeed}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1" Minimum="1" Maximum="60" Value="{Binding HorseSpeed}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding HorseSpeed, StringFormat='{}{0:0} / 60'}" Foreground="#E5C478" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    </Grid>

                                    <Grid Margin="0,0,0,8">

                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc_HorseCapacity}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1" Minimum="1" Maximum="600" Value="{Binding HorseCapacity}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding HorseCapacity, StringFormat='{}{0:0} / 600'}" Foreground="#E5C478" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    </Grid>

                                    <Grid Margin="0,0,0,8">

                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc_HorseCourage}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1" Minimum="1" Maximum="25" Value="{Binding HorseCourage}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding HorseCourage, StringFormat='{}{0:0} / 25'}" Foreground="#E5C478" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    </Grid>

                                    <Grid>

                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc_HorseStamina}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1" Minimum="1" Maximum="500" Value="{Binding HorseStamina}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding HorseStamina, StringFormat='{}{0:0} / 500'}" Foreground="#E5C478" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    </Grid>

                                </StackPanel>

                            </Border>



                            <!-- Horse Saddlebags Items -->

                            <TextBlock Text="{Binding Loc_HorseInventory}" FontSize="10" FontWeight="Bold" Foreground="#C9A24D" Margin="0,0,0,6"/>

                            <Border Background="#141822" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="6" MinHeight="100">

                                <ListView ItemsSource="{Binding FilteredHorseItems}" Background="Transparent" BorderThickness="0">

                                    <ListView.ItemTemplate>

                                        <DataTemplate DataType="{x:Type vm:InventoryItemViewModel}">

                                            <Grid Margin="0,2">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="50" />

                                                    <ColumnDefinition Width="60" />

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding ItemUiName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>

                                                <TextBlock Grid.Column="1" Text="{Binding FormattedAmount, StringFormat='{}# {0}'}" Foreground="#E5C478" FontFamily="Consolas" FontSize="11"/>

                                                <TextBlock Grid.Column="2" Text="{Binding FormattedWeight, StringFormat='{}{0} kg'}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/>

                                            </Grid>

                                        </DataTemplate>

                                    </ListView.ItemTemplate>

                                </ListView>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>



                    <!-- FOOTER: HAUPTSTUFE (MATCHING SCREENSHOT BOTTOM-RIGHT) -->

                    <Border Grid.Row="2" BorderBrush="#40C9A24D" BorderThickness="0,1,0,0" Padding="12,8">

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                                <GradientStop Color="#1A1510" Offset="0"/>

                                <GradientStop Color="#261E12" Offset="0.5"/>

                                <GradientStop Color="#1A1510" Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>



                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <TextBlock Text="✦ " Foreground="#C9A24D" VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding Loc_FooterLevel}" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <Border Background="#30000000" BorderBrush="#80C9A24D" BorderThickness="1" CornerRadius="6" Padding="6,2">

                                <TextBox Text="{Binding CharacterLevel, UpdateSourceTrigger=LostFocus}" Width="35" TextAlignment="Center"

                                         FontWeight="Bold" FontSize="14" Foreground="#E5C478" Background="Transparent" BorderThickness="0"/>

                            </Border>

                            <TextBlock Text=" ✦" Foreground="#C9A24D" VerticalAlignment="Center" Margin="6,0,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

        </Grid>


            <!-- ================================================================= -->

            <!-- TAB 2: QUESTLOG (INTERACTIVE QUEST & OBJECTIVE EDITOR)           -->

            <!-- ================================================================= -->

            <Grid Visibility="{Binding SelectedMainTab, Converter={StaticResource EqToVis}, ConverterParameter='Questlog'}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Sub-Tabs: Missions vs Fates -->
                    <RowDefinition Height="*"/>    <!-- Sub-Tab Content -->
                </Grid.RowDefinitions>

                <!-- Sub-Tabs Navigation Bar -->
                <Border Grid.Row="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Margin="0,0,0,6" Padding="6,4,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Loc_MissionsTab}"
                                Command="{Binding SwitchQuestSubTabCommand}" CommandParameter="Missions"
                                Style="{StaticResource QuestSubTabMissionsButton}" Margin="0,0,8,0"/>
                        <Button Content="{Binding Loc_CharactersAndFatesTab}"
                                Command="{Binding SwitchQuestSubTabCommand}" CommandParameter="Fates"
                                Style="{StaticResource QuestSubTabFatesButton}" Margin="0,0,8,0"/>
                    </StackPanel>
                </Border>

                <!-- SUB-TAB 1: MISSIONS LOG -->
                <Grid Grid.Row="1" Visibility="{Binding IsQuestSubTabMissions, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="380"/>
                        <ColumnDefinition Width="8"/> <!-- Spacer -->
                        <ColumnDefinition Width="7*" MinWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Quest Directory & Categories & Regions -->
                    <Border Grid.Column="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="Auto"/> <!-- Quest Type Filter Sub-Tabs -->
                                <RowDefinition Height="Auto"/> <!-- Quest Region Filter Row -->
                                <RowDefinition Height="Auto"/> <!-- Quest Search Bar -->
                                <RowDefinition Height="*"/>    <!-- Quest List -->
                            </Grid.RowDefinitions>

                            <!-- Quest Directory Header -->
                            <Border Grid.Row="0" Background="#0E1117" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📜 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Loc_QuestlogTitle}" FontSize="13" FontWeight="Bold" Foreground="#E5C478" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="{Binding Loc_QuestUnlockAll}" Command="{Binding UnlockAllQuestsCommand}" Style="{StaticResource SecondarySmallButton}" HorizontalAlignment="Right" Padding="8,3"/>
                                </Grid>
                            </Border>

                            <!-- Filter Row 1: Quest Types (All, Main, Side, Activity) -->
                            <Border Grid.Row="1" Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="4">
                                <UniformGrid Columns="4">
                                    <Button Content="{Binding Loc_QuestTabAll}" Command="{Binding FilterQuestsCommand}" CommandParameter="all" Style="{StaticResource QuestFilterAllButton}"/>
                                    <Button Content="{Binding Loc_QuestTabMain}" Command="{Binding FilterQuestsCommand}" CommandParameter="haupt" Style="{StaticResource QuestFilterHauptButton}"/>
                                    <Button Content="{Binding Loc_QuestTabSide}" Command="{Binding FilterQuestsCommand}" CommandParameter="neben" Style="{StaticResource QuestFilterNebenButton}"/>
                                    <Button Content="{Binding Loc_QuestTabActivity}" Command="{Binding FilterQuestsCommand}" CommandParameter="aktiv" Style="{StaticResource QuestFilterAktivButton}"/>
                                </UniformGrid>
                            </Border>

                            <!-- Filter Row 2: Regions (All Regions, Trosecko, Kutnohorsko) -->
                            <Border Grid.Row="2" Background="#0F1218" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="4">
                                <UniformGrid Columns="3">
                                    <Button Content="{Binding Loc_QuestTabAllRegions}" Command="{Binding FilterQuestRegionCommand}" CommandParameter="all" Style="{StaticResource QuestRegionAllButton}"/>
                                    <Button Content="{Binding Loc_QuestTabTrosecko}" Command="{Binding FilterQuestRegionCommand}" CommandParameter="Trosecko" Style="{StaticResource QuestRegionTroseckoButton}"/>
                                    <Button Content="{Binding Loc_QuestTabKutnohorsko}" Command="{Binding FilterQuestRegionCommand}" CommandParameter="Kutnohorsko" Style="{StaticResource QuestRegionKutnohorskoButton}"/>
                                </UniformGrid>
                            </Border>

                            <!-- Quest Search Bar -->
                            <Border Grid.Row="3" Background="#0F1219" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="8,6">
                                <Border Background="#161B26" BorderBrush="#35C9A24D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center" Foreground="#C9A24D"/>
                                        <TextBox Grid.Column="1" Text="{Binding QuestSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"
                                                 CaretBrush="#C9A24D" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Quest List -->
                            <ListBox Grid.Row="4" ItemsSource="{Binding FilteredQuests}" SelectedItem="{Binding SelectedQuest, Mode=TwoWay}"
                                     Background="#0D1016" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="itemBd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" Padding="12,10">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="itemBd" Property="Background" Value="#1A202C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="itemBd" Property="Background" Value="#25C9A24D"/>
                                                            <Setter TargetName="itemBd" Property="BorderBrush" Value="#C9A24D"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuestItemViewModel}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Region + Location -->
                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <Border Background="{Binding RegionBadgeBackground}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RegionBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding RegionBadgeForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayLocation}" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- PONR + Status Badges -->
                                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                                    <Border Visibility="{Binding IsPointOfNoReturn, Converter={StaticResource BoolToVis}}" Background="#7F1D1D" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.Loc_PointOfNoReturnBadge}" FontSize="9" FontWeight="Bold" Foreground="#FCA5A5"/>
                                                    </Border>
                                                    <Border Background="{Binding StatusBadgeBackground}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StageFormatted}" FontSize="10" FontFamily="Consolas" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right Column: Quest Objective & State Inspector -->
                    <Border Grid.Column="2" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title & Status Buttons -->
                                <RowDefinition Height="Auto"/> <!-- Point of No Return Warning Callout -->
                                <RowDefinition Height="1"/>    <!-- Separator -->
                                <RowDefinition Height="Auto"/> <!-- Objectives Header -->
                                <RowDefinition Height="*"/>    <!-- Objectives List -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Quest Title, Location, and Status Action Buttons -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="{Binding SelectedQuest.RegionBadgeBackground}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SelectedQuest.RegionBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding SelectedQuest.RegionBadgeForeground}" FontFamily="Consolas"/>
                                        </Border>
                                        <Border Background="#20C9A24D" BorderBrush="#50C9A24D" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedQuest.TypeBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedQuest.DisplayLocation}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedQuest.DisplayTitle}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                    <Button Content="{Binding Loc_QuestStatusActive}" Command="{Binding SetQuestStatusCommand}" CommandParameter="aktiv" Style="{StaticResource QuestStatusActiveButton}" Margin="0,0,6,0"/>
                                    <Button Content="{Binding Loc_QuestStatusCompleted}" Command="{Binding SetQuestStatusCommand}" CommandParameter="abgeschlossen" Style="{StaticResource QuestStatusCompletedButton}" Margin="0,0,6,0"/>
                                    <Button Content="{Binding Loc_QuestStatusFailed}" Command="{Binding SetQuestStatusCommand}" CommandParameter="fehlgeschlagen" Style="{StaticResource QuestStatusFailedButton}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Point of No Return Warning Callout Banner -->
                            <Border Grid.Row="1" Visibility="{Binding SelectedQuest.IsPointOfNoReturn, Converter={StaticResource BoolToVis}}"
                                    Background="#2D1115" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Loc_PointOfNoReturnBadge}" FontSize="12" FontWeight="Bold" Foreground="#F43F5E" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedQuest.PointOfNoReturnWarning}" FontSize="11" Foreground="#FDA4AF" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 2: Separator -->
                            <Rectangle Grid.Row="2" Fill="#20FFFFFF" Margin="0,14"/>

                            <!-- Row 3: Objectives Header -->
                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✦ " Foreground="#C9A24D" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Loc_QuestObjectivesHeader}" FontSize="12" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="{Binding Loc_QuestCompleteAll}" Command="{Binding AutocompleteObjectivesCommand}" Style="{StaticResource SecondarySmallButton}"
                                        Foreground="#E5C478" BorderBrush="#50C9A24D" Background="#15C9A24D" Padding="10,4" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Row 4: Objectives List -->
                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SelectedQuest.Objectives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:QuestObjectiveViewModel}">
                                            <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding StatusActiveText}" FontSize="10" Foreground="#38BDF8" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SUB-TAB 2: CHARACTERS & WORLD FATES -->
                <Grid Grid.Row="1" Visibility="{Binding IsQuestSubTabFates, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="380"/>
                        <ColumnDefinition Width="8"/> <!-- Spacer -->
                        <ColumnDefinition Width="7*" MinWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Character Cards & Filters -->
                    <Border Grid.Column="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Category Filter Pills -->
                                <RowDefinition Height="Auto"/> <!-- Search Box -->
                                <RowDefinition Height="*"/>    <!-- Character Cards List -->
                            </Grid.RowDefinitions>

                            <!-- Category Filter Pills -->
                            <Border Grid.Row="0" Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="4">
                                <UniformGrid Columns="4">
                                    <Button Content="{Binding Loc_FateFilterAll}" Command="{Binding FilterFateCategoryCommand}" CommandParameter="all" Style="{StaticResource FateFilterAllButton}"/>
                                    <Button Content="{Binding Loc_FateFilterVip}" Command="{Binding FilterFateCategoryCommand}" CommandParameter="vip" Style="{StaticResource FateFilterVipButton}"/>
                                    <Button Content="{Binding Loc_FateFilterDecision}" Command="{Binding FilterFateCategoryCommand}" CommandParameter="decision" Style="{StaticResource FateFilterDecisionButton}"/>
                                    <Button Content="{Binding Loc_FateFilterMerchant}" Command="{Binding FilterFateCategoryCommand}" CommandParameter="craftsman" Style="{StaticResource FateFilterMerchantButton}"/>
                                </UniformGrid>
                            </Border>

                            <!-- Search Filter Box -->
                            <Border Grid.Row="1" Background="#0F1219" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="8,6">
                                <Border Background="#161B26" BorderBrush="#35C9A24D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center" Foreground="#C9A24D"/>
                                        <TextBox Grid.Column="1" Text="{Binding FateSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"
                                                 CaretBrush="#C9A24D" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Character Cards List -->
                            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredCharacterFates}" SelectedItem="{Binding SelectedCharacterFate, Mode=TwoWay}"
                                     Background="#0D1016" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="itemBorder" Background="#131720" BorderBrush="#1A202C" BorderThickness="0,0,0,1" Padding="12,10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="#1C2333"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="#221C14"/>
                                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="#C9A24D"/>
                                                            <Setter TargetName="itemBorder" Property="BorderThickness" Value="3,0,0,1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameCharacterFateViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                <ColumnDefinition Width="*"/>    <!-- Name, Role, Location -->
                                                <ColumnDefinition Width="Auto"/> <!-- Status Badge -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Background="#1E2430" CornerRadius="6" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name & Role -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding DisplayRole}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text=" • " FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding DisplayLocation}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" Background="{Binding StatusBadgeBackground}" BorderThickness="0" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right Column: World State & Selected Character Fate Detail -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- World State Card -->
                            <RowDefinition Height="*"/>    <!-- Selected Character Card -->
                        </Grid.RowDefinitions>

                        <!-- World State & Milestones Card -->
                        <Border Grid.Row="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="14,12">
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌍 " FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Loc_WorldStateHeader}" FontSize="13" FontWeight="Bold" Foreground="#E5C478" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Active Story Region Pill -->
                                    <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc_CurrentStoryRegion}" FontSize="10" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentStoryRegionDisplay}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- World Milestone: Radzig's Reforged Master Sword -->
                                <Border Background="#171C26" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc_RaczekSwordReforgedLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding Loc_RaczekSwordReforgedDesc}" FontSize="10" Foreground="#64748B" FontFamily="Consolas" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsRaczekSwordReforged, Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Selected Character Detail & Action Card -->
                        <Border Grid.Row="1" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Character Header Card -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#1E2430" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedCharacterFate.Icon}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedCharacterFate.DisplayName}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{Binding SelectedCharacterFate.CategoryBadgeBackground}" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding SelectedCharacterFate.CategoryBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding SelectedCharacterFate.CategoryBadgeForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedCharacterFate.DisplayRole}" FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text=" • " FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding SelectedCharacterFate.DisplayLocation}" FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{Binding SelectedCharacterFate.StatusBadgeBackground}" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedCharacterFate.StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedCharacterFate.StatusBadgeForeground}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Lore / Story Description Box -->
                                    <Border Background="#161B26" BorderBrush="#262C3A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc_FateLoreHeader}" FontSize="10" FontWeight="Bold" Foreground="#C9A24D" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding SelectedCharacterFate.DisplayDescription}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Actions / Controls Section -->
                                    <Border Background="#141822" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc_FateActionsHeader}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,10"/>

                                            <!-- CASE 1: Story VIP (Immortal) -->
                                            <Border Visibility="{Binding SelectedCharacterFate.IsStoryVip, Converter={StaticResource BoolToVis}}"
                                                    Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🛡️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Loc_FateVipProtectionTitle}" FontSize="12" FontWeight="Bold" Foreground="#C7D2FE"/>
                                                        <TextBlock Text="{Binding Loc_FateVipProtectionDesc}" FontSize="10" Foreground="#A5B4FC" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- CASE 2: Decision Choice (Spared vs Executed) -->
                                            <StackPanel Visibility="{Binding SelectedCharacterFate.IsDecisionCharacter, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Loc_FateDecisionToggleHeader}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <Button Content="{Binding Loc_ChoiceSpared}"
                                                            Command="{Binding SetCharacterStatusCommand}" CommandParameter="Spared"
                                                            Background="#14532D" Foreground="#86EFAC" FontWeight="Bold" Padding="10,8" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Content="{Binding Loc_ChoiceExecuted}"
                                                            Command="{Binding SetCharacterStatusCommand}" CommandParameter="Executed"
                                                            Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="Bold" Padding="10,8" Margin="4,0,0,0" Cursor="Hand" BorderThickness="0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </UniformGrid>
                                            </StackPanel>

                                            <!-- CASE 3: Craftsman / Mortal Merchant (Revive Button) -->
                                            <StackPanel Visibility="{Binding SelectedCharacterFate.IsCraftsman, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Loc_FateMortalCraftsmanTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                                        <TextBlock Text="{Binding Loc_FateMortalCraftsmanDesc}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{Binding SelectedCharacterFate.StatusBadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedCharacterFate.StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding SelectedCharacterFate.StatusBadgeForeground}"/>
                                                    </Border>
                                                </Grid>

                                                <Button Content="{Binding Loc_ReviveButton}"
                                                        Command="{Binding ReviveCharacterCommand}"
                                                        IsEnabled="{Binding SelectedCharacterFate.CanBeRevived}"
                                                        Style="{StaticResource GoldButton}"
                                                        HorizontalAlignment="Stretch" Padding="14,10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SelectedMainTab, Converter={StaticResource EqToVis}, ConverterParameter='Spieler'}">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/> <!-- Sub-Tabs Ribbon -->

                    <RowDefinition Height="*"/>    <!-- Sub-Tab Content -->

                </Grid.RowDefinitions>



                <!-- Sub-Tabs: Heinrich / Köter (Gefährte) / Pebbles -->

                <Border Grid.Row="0" Background="#121620" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,10">

                    <Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                            <Button Command="{Binding SwitchPlayerSubTabCommand}" CommandParameter="Henry" Style="{StaticResource PlayerSubHenryButton}" Margin="0,0,6,0">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="👤" FontSize="12" Margin="0,0,6,0"/>

                                    <TextBlock Text="{Binding Loc_PlayerSubHenry}"/>

                                </StackPanel>

                            </Button>

                            <Button Command="{Binding SwitchPlayerSubTabCommand}" CommandParameter="Dog" Style="{StaticResource PlayerSubDogButton}" Margin="0,0,6,0">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="🐾" FontSize="12" Margin="0,0,6,0"/>

                                    <TextBlock Text="{Binding Loc_PlayerSubDog}"/>

                                </StackPanel>

                            </Button>

                            <Button Command="{Binding SwitchPlayerSubTabCommand}" CommandParameter="Horse" Style="{StaticResource PlayerSubHorseButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="🛡️" FontSize="12" Margin="0,0,6,0"/>

                                    <TextBlock Text="{Binding Loc_PlayerSubHorse}"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">

                            <TextBlock Text="{Binding Loc_CompanionAiStatus}" FontSize="11" Foreground="#10B981" FontFamily="Consolas"/>

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- Sub-View 1: Henry (Faction Reputation & Special Perks) -->

                <Grid Grid.Row="1" Visibility="{Binding SelectedPlayerSubTab, Converter={StaticResource EqToVis}, ConverterParameter='Henry'}">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1*"/>

                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>



                    <!-- Left: Faction Reputation -->

                    <Border Grid.Column="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">

                                <TextBlock Text="👑 " FontSize="13" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Loc_FactionsTitle}" FontSize="12" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding Factions}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type vm:FactionRepViewModel}">

                                            <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">

                                                <StackPanel>

                                                    <Grid Margin="0,0,0,4">

                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>

                                                        <TextBlock Text="{Binding FormattedReputation}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                                    </Grid>

                                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Reputation, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Grid>

                    </Border>



                    <!-- Right: Special Perks Grid -->

                    <Border Grid.Column="2" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock Text="✨ " FontSize="13" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding Loc_PerksTitle}" FontSize="12" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                </StackPanel>

                                <Button Content="{Binding Loc_PerksUnlockAll}" Command="{Binding UnlockAllPerksCommand}" Style="{StaticResource DarkUtilityButton}"

                                        Foreground="#E5C478" BorderBrush="#50C9A24D" Background="#15C9A24D" Padding="10,4" HorizontalAlignment="Right" FontSize="11"/>

                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding Perks}">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <UniformGrid Columns="2"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type vm:PerkItemViewModel}">

                                            <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="3">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Grid>

                    </Border>

                </Grid>



                <!-- Sub-View 2: Köter (Dog / Mutt Companion) -->

                <Grid Grid.Row="1" Visibility="{Binding SelectedPlayerSubTab, Converter={StaticResource EqToVis}, ConverterParameter='Dog'}">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="4*" MinWidth="320"/>

                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="8*" MinWidth="540"/>

                    </Grid.ColumnDefinitions>



                    <!-- Left: Dog Profile & Instant Max Button -->

                    <Border Grid.Column="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="16">

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">

                            <Border Width="80" Height="80" CornerRadius="40" Background="#302008" BorderBrush="#C9A24D" BorderThickness="2" Margin="0,0,0,10" HorizontalAlignment="Center">

                                <TextBlock Text="🐕" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="{Binding Loc_DogTitle}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Loc_DogSubtitle}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,2,0,16"/>



                            <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">

                                <StackPanel>

                                    <Grid Margin="0,3">

                                        <TextBlock Text="{Binding Loc_DogCondition}" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_DogConditionVal}" Foreground="#10B981" FontWeight="Bold" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                    </Grid>

                                    <Grid Margin="0,3">

                                        <TextBlock Text="{Binding Loc_DogRank}" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_DogRankVal}" Foreground="#F6E05E" FontWeight="Bold" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                    </Grid>

                                    <Grid Margin="0,3">

                                        <TextBlock Text="{Binding Loc_DogCommand}" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_DogCommandVal}" Foreground="#CBD5E1" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                    </Grid>

                                </StackPanel>

                            </Border>



                            <Button Content="{Binding Loc_DogMax}" Command="{Binding MaxDogStatsCommand}" Style="{StaticResource GoldButton}" Padding="12,10" HorizontalAlignment="Stretch" FontSize="11"/>

                        </StackPanel>

                    </Border>



                    <!-- Right: Dog Attributes Sliders & Houndmaster Perks -->

                    <Border Grid.Column="2" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="16">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>



                            <!-- Sliders Header -->

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

                                <TextBlock Text="🎚️ " FontSize="13" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Loc_DogAttributesHeader}" FontSize="12" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                            </StackPanel>



                            <!-- Sliders Grid (2 Columns) -->

                            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">

                                <!-- Loyalty -->

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">

                                            <TextBlock Text="{Binding Loc_DogLoyalty}" FontSize="11" Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding DogLoyalty, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Slider Minimum="0" Maximum="100" Value="{Binding DogLoyalty, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                                <!-- Obedience -->

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">

                                            <TextBlock Text="{Binding Loc_DogObedience}" FontSize="11" Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding DogObedience, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Slider Minimum="0" Maximum="100" Value="{Binding DogObedience, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                                <!-- Nourishment -->

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">

                                            <TextBlock Text="{Binding Loc_DogNourishment}" FontSize="11" Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding DogHunger, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Slider Minimum="0" Maximum="100" Value="{Binding DogHunger, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                                <!-- Aggression -->

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">

                                            <TextBlock Text="{Binding Loc_DogAggression}" FontSize="11" Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding DogAggression, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Slider Minimum="0" Maximum="100" Value="{Binding DogAggression, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </UniformGrid>



                            <!-- Perks Header -->

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">

                                <TextBlock Text="🏆 " FontSize="13" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Loc_DogPerksHeader}" FontSize="12" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                            </StackPanel>



                            <!-- Houndmaster Perks Grid -->

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding DogPerks}">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <UniformGrid Columns="2"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type vm:DogPerkItemViewModel}">

                                            <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0"/>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Grid>

                    </Border>

                </Grid>



                <!-- Sub-View 3: Horse (Schimmel / Pebbles) -->

                <Grid Grid.Row="1" Visibility="{Binding SelectedPlayerSubTab, Converter={StaticResource EqToVis}, ConverterParameter='Horse'}">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="1*"/>

                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>



                    <!-- Left: Mount Equipment Summary -->

                    <Border Grid.Column="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="16">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                                <TextBlock Text="🛡️ " FontSize="13" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Loc_HorseFullMountTitle}" FontSize="13" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                            </StackPanel>

                            <TextBlock Text="{Binding Loc_HorseFullMountDesc}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,0,0,14"/>



                            <!-- Mount Selector & Profile Card -->

                            <Border Background="#151A24" BorderBrush="#40C9A24D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#40854D0E" BorderBrush="#80C9A24D" BorderThickness="1" Margin="0,0,12,0">

                                        <TextBlock Text="🐎" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding Loc_SelectHorseLabel}" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,0,0,3"/>

                                        <ComboBox Grid.Row="1" ItemsSource="{Binding AvailableHorses}" SelectedItem="{Binding SelectedHorseOption, Mode=TwoWay}"

                                                  Background="#161B26" Foreground="#F6E05E" BorderBrush="#50C9A24D" BorderThickness="1" Padding="6,4"

                                                  FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch">

                                            <ComboBox.ItemTemplate>

                                                <DataTemplate DataType="{x:Type vm:HorseOptionViewModel}">

                                                    <Grid Margin="0,2">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="Auto"/>

                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">

                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>

                                                            <TextBlock Text="{Binding DisplayBreed}" Foreground="#94A3B8" FontSize="10"/>

                                                        </StackPanel>

                                                        <Border Grid.Column="1" Background="#25C9A24D" BorderBrush="#60C9A24D" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">

                                                            <TextBlock Text="{Binding TierDisplay}" Foreground="#F6E05E" FontSize="9" FontWeight="Bold"/>

                                                        </Border>

                                                    </Grid>

                                                </DataTemplate>

                                            </ComboBox.ItemTemplate>

                                        </ComboBox>

                                    </Grid>

                                    <Button Grid.Column="2" Command="{Binding MaxHorseStatsCommand}" Style="{StaticResource DarkUtilityButton}" ToolTip="{Binding Loc_MaxHorseStatsTip}">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="⚡ " Foreground="#FCD34D"/>

                                            <TextBlock Text="{Binding Loc_MaxHorseStatsBtn}" FontWeight="Bold"/>

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Border>



                            <UniformGrid Columns="2" Margin="0,0,0,10">

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Loc_HorseSaddle}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_SaddleDefault}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Loc_HorseShoes}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_HorseshoesDefault}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Loc_HorseCaparison}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_CaparisonDefault}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Loc_HorseBridle}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_BridleDefault}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>

                                    </StackPanel>

                                </Border>

                            </UniformGrid>

                        </StackPanel>

                    </Border>



                    <!-- Right: Horsemanship & Mount Stats -->

                    <Border Grid.Column="2" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="16">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock Text="🐎 " FontSize="13" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding Loc_HorseRidingSkills}" FontSize="12" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                </StackPanel>

                                <Button Content="{Binding Loc_MaxStats}" Command="{Binding MaxHorseStatsCommand}" Style="{StaticResource GoldButton}" Padding="8,4" HorizontalAlignment="Right" FontSize="11"/>

                            </Grid>

                            <StackPanel Grid.Row="1">

                                <!-- Speed -->

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">

                                            <TextBlock Text="{Binding Loc_HorseSpeed}" FontSize="11" Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding HorseSpeed, StringFormat='{}{0} / 60'}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Slider Minimum="1" Maximum="60" Value="{Binding HorseSpeed, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                                <!-- Capacity -->

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">

                                            <TextBlock Text="{Binding Loc_HorseCapacity}" FontSize="11" Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding HorseCapacity, StringFormat='{}{0} / 600'}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Slider Minimum="1" Maximum="600" Value="{Binding HorseCapacity, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                                <!-- Courage -->

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">

                                            <TextBlock Text="{Binding Loc_HorseCourage}" FontSize="11" Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding HorseCourage, StringFormat='{}{0} / 25'}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Slider Minimum="1" Maximum="25" Value="{Binding HorseCourage, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                                <!-- Stamina -->

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">

                                            <TextBlock Text="{Binding Loc_HorseStamina}" FontSize="11" Foreground="#CBD5E1"/>

                                            <TextBlock Text="{Binding HorseStamina, StringFormat='{}{0} / 500'}" FontSize="11" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" HorizontalAlignment="Right"/>

                                        </Grid>

                                        <Slider Minimum="1" Maximum="500" Value="{Binding HorseStamina, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>



            <!-- ================================================================= -->

            <!-- TAB 4: HANDWERKSKUNST (HERBS POUCH, BLACKSMITHING & ALCHEMY)     -->

            <!-- ================================================================= -->

            <Grid Visibility="{Binding SelectedMainTab, Converter={StaticResource EqToVis}, ConverterParameter='Handwerk'}">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="380" MinWidth="340"/>

                    <ColumnDefinition Width="10"/> <!-- Spacer -->

                    <ColumnDefinition Width="*" MinWidth="600"/>

                </Grid.ColumnDefinitions>



                <!-- ============================================================= -->

                <!-- LEFT COLUMN: BOTANICAL HERB POUCH & BLACKSMITHING WORKSHOP    -->

                <!-- ============================================================= -->

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>    <!-- Row 0: Kräuterbeutel -->

                        <RowDefinition Height="10"/>   <!-- Spacer -->

                        <RowDefinition Height="Auto"/> <!-- Row 1: Schmiede-Werkstatt -->

                    </Grid.RowDefinitions>



                    <!-- Top Card: Kräuterbeutel & Alchemistische Zutaten -->

                    <Border Grid.Row="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="14">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/> <!-- Header -->

                                <RowDefinition Height="*"/>    <!-- Herb Grid List -->

                            </Grid.RowDefinitions>



                            <Grid Grid.Row="0" Margin="0,0,0,10">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock Text="🌸 " FontSize="14" Foreground="#34D399" VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding Loc_HerbsTitle}" FontSize="12" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>

                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                    <Button Content="{Binding Loc_HerbsBatch}" Command="{Binding AddHerbsBatchCommand}" CommandParameter="50"

                                            Style="{StaticResource DarkUtilityButton}" Foreground="#6EE7B7" BorderBrush="#4010B981" Background="#2010B981"

                                            Padding="8,3" FontSize="10" Margin="0,0,6,0"/>

                                    <Button Content="{Binding Loc_HerbsMaxAll}" Command="{Binding MaxAllHerbsCommand}"

                                            Style="{StaticResource GoldButton}" Padding="8,3" FontSize="10"/>

                                </StackPanel>

                            </Grid>



                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding Herbs}">

                                    <ItemsControl.ItemsPanel>

                                        <ItemsPanelTemplate>

                                            <UniformGrid Columns="2"/>

                                        </ItemsPanelTemplate>

                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type vm:HerbItemViewModel}">

                                            <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,5" Margin="2">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto"/>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="4" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" Margin="0,0,6,0">

                                                        <TextBlock Text="{Binding Icon}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <Border Background="#090B0F" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="4" Padding="3,1" Margin="0,0,3,0">

                                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="34" TextAlignment="Right"

                                                                     FontSize="11" FontWeight="Bold" Foreground="#6EE7B7" FontFamily="Consolas" Background="Transparent" BorderThickness="0"/>

                                                        </Border>

                                                        <Button Content="+10" Command="{Binding DataContext.AddHerbCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"

                                                                Style="{StaticResource DarkUtilityButton}" Padding="4,1" FontSize="10"/>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Grid>

                    </Border>



                    <!-- Bottom Card: Schmiede-Werkstatt & Klingenpflege -->

                    <Border Grid.Row="2" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="14">

                        <StackPanel>

                            <Grid Margin="0,0,0,10">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock Text="⚒️ " FontSize="14" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding Loc_SmithingTitle}" FontSize="12" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                </StackPanel>

                                <Button Content="{Binding Loc_SmithingMax}" Command="{Binding MaxSmithingStatsCommand}" Style="{StaticResource GoldButton}" Padding="10,4" HorizontalAlignment="Right" FontSize="10"/>

                            </Grid>



                            <UniformGrid Columns="2">

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Loc_SmithingLevel}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_SmithingLevelVal}" FontSize="13" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" Margin="0,2,0,0"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#141822" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Loc_SmithingHardness}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>

                                        <TextBlock Text="{Binding Loc_SmithingHardnessVal}" FontSize="13" FontWeight="Bold" Foreground="#34D399" FontFamily="Consolas" Margin="0,2,0,0"/>

                                    </StackPanel>

                                </Border>

                            </UniformGrid>

                        </StackPanel>

                    </Border>

                </Grid>



                <!-- ============================================================= -->

                <!-- RIGHT COLUMN: CRAFTING CODEX (ALL RECIPES & TALENTS)          -->

                <!-- ============================================================= -->

                <Border Grid.Column="2" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="14">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/> <!-- Header with counters and batch buttons -->

                            <RowDefinition Height="Auto"/> <!-- Filter & Search toolbar -->

                            <RowDefinition Height="*"/>    <!-- Scrollable Recipe / Perk list -->

                        </Grid.RowDefinitions>



                        <!-- Row 0: Header & Batch Actions -->

                        <Grid Grid.Row="0" Margin="0,0,0,10">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <TextBlock Text="📜 " FontSize="14" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Loc_CraftTitle}" FontSize="13" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Loc_CraftSummary}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>

                            </StackPanel>



                            <!-- Batch Buttons (Toggle between Recipes and Perks commands) -->

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                <!-- When Recipes view -->

                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCraftTabPerksSelected, Converter={StaticResource InverseBoolToVis}}">

                                    <Button Content="{Binding Loc_CraftLearnAll}" Command="{Binding UnlockAllCraftingCommand}"

                                            Style="{StaticResource DarkUtilityButton}" Foreground="#6EE7B7" BorderBrush="#4010B981" Background="#2010B981"

                                            Padding="10,4" FontSize="11" Margin="0,0,6,0"/>

                                    <Button Content="{Binding Loc_CraftUnlearnAll}" Command="{Binding LockAllCraftingCommand}"

                                            Style="{StaticResource DarkUtilityButton}" Foreground="#FCA5A5" BorderBrush="#40EF4444" Background="#20EF4444"

                                            Padding="10,4" FontSize="11"/>

                                </StackPanel>



                                <!-- When Perks view -->

                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCraftTabPerksSelected, Converter={StaticResource BoolToVis}}">

                                    <Button Content="{Binding Loc_CraftLearnAll}" Command="{Binding UnlockAllCraftingPerksCommand}"

                                            Style="{StaticResource DarkUtilityButton}" Foreground="#6EE7B7" BorderBrush="#4010B981" Background="#2010B981"

                                            Padding="10,4" FontSize="11" Margin="0,0,6,0"/>

                                    <Button Content="{Binding Loc_CraftUnlearnAll}" Command="{Binding LockAllCraftingPerksCommand}"

                                            Style="{StaticResource DarkUtilityButton}" Foreground="#FCA5A5" BorderBrush="#40EF4444" Background="#20EF4444"

                                            Padding="10,4" FontSize="11"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>



                        <!-- Row 1: Filter & Search Bar -->

                        <Border Grid.Row="1" Background="#0E1117" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/> <!-- Category Tabs -->

                                    <ColumnDefinition Width="Auto"/> <!-- Divider -->

                                    <ColumnDefinition Width="Auto"/> <!-- Status Filter Pills -->

                                    <ColumnDefinition Width="*"/>    <!-- Search Input -->

                                </Grid.ColumnDefinitions>



                                <!-- Category Filter Sub-Tabs -->

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                    <Button Content="{Binding Loc_CraftFilterAll}" Command="{Binding SelectCraftFilterCommand}" CommandParameter="All"

                                            Style="{StaticResource CraftFilterTabAllButton}" Margin="0,0,3,0"/>

                                    <Button Content="{Binding Loc_CraftFilterAlchemy}" Command="{Binding SelectCraftFilterCommand}" CommandParameter="Alchemy"

                                            Style="{StaticResource CraftFilterTabAlchemyButton}" Margin="0,0,3,0"/>

                                    <Button Content="{Binding Loc_CraftFilterBlacksmith}" Command="{Binding SelectCraftFilterCommand}" CommandParameter="Blacksmithing"

                                            Style="{StaticResource CraftFilterTabSmithButton}" Margin="0,0,3,0"/>

                                    <Button Content="{Binding Loc_CraftFilterPerks}" Command="{Binding SelectCraftFilterCommand}" CommandParameter="Perks"

                                            Style="{StaticResource CraftFilterTabPerksButton}"/>

                                </StackPanel>



                                <!-- Vertical Divider -->

                                <Border Grid.Column="1" Width="1" Background="#25FFFFFF" Margin="8,2" VerticalAlignment="Stretch"/>



                                <!-- Status Filter Pills -->

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                    <Button Content="{Binding Loc_CraftStatusAll}" Command="{Binding SelectCraftStatusFilterCommand}" CommandParameter="All"

                                            Style="{StaticResource CraftStatusAllButton}" Margin="0,0,3,0"/>

                                    <Button Content="{Binding Loc_CraftStatusLearned}" Command="{Binding SelectCraftStatusFilterCommand}" CommandParameter="Learned"

                                            Style="{StaticResource CraftStatusLearnedButton}" Margin="0,0,3,0"/>

                                    <Button Content="{Binding Loc_CraftStatusUnlearned}" Command="{Binding SelectCraftStatusFilterCommand}" CommandParameter="Unlearned"

                                            Style="{StaticResource CraftStatusUnlearnedButton}"/>

                                </StackPanel>



                                <!-- Live Search Bar -->

                                <Border Grid.Column="3" Background="#090B0F" BorderBrush="#352F22" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#94A3B8"/>

                                        <TextBox Grid.Column="1" Text="{Binding CraftSearchFilter, UpdateSourceTrigger=PropertyChanged}"

                                                 Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"

                                                 CaretBrush="#C9A24D" VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Border>



                        <!-- Row 2: Recipe / Perk List Views -->

                        <Grid Grid.Row="2">

                            <!-- VIEW A: RECIPES (ALCHEMY & BLACKSMITHING) -->

                            <ScrollViewer Visibility="{Binding IsCraftTabPerksSelected, Converter={StaticResource InverseBoolToVis}}" VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding FilteredCraftingRecipes}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type vm:CraftingRecipeViewModel}">

                                            <Border Background="#141822" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto"/> <!-- Badge & Icon -->

                                                        <ColumnDefinition Width="*"/>    <!-- Title, Desc & Ingredients -->

                                                        <ColumnDefinition Width="Auto"/> <!-- CheckBox -->

                                                    </Grid.ColumnDefinitions>



                                                    <!-- Left: Icon & Category Badge -->

                                                    <StackPanel Grid.Column="0" Width="100" VerticalAlignment="Center" Margin="0,0,10,0">

                                                        <Border Background="{Binding CategoryBadgeColor}" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Margin="0,0,0,4">

                                                            <TextBlock Text="{Binding CategoryDisplayName}" Foreground="#090B0F" FontSize="8.5" FontWeight="ExtraBold" FontFamily="Consolas"/>

                                                        </Border>

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,4,0"/>

                                                            <TextBlock Text="{Binding MinSkillLevel, StringFormat='St. {0}'}" FontSize="9.5" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" VerticalAlignment="Center"/>

                                                        </StackPanel>

                                                    </StackPanel>



                                                    <!-- Center: Details -->

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>

                                                        <TextBlock Text="{Binding DisplayDescription}" FontSize="10" Foreground="#94A3B8" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,2"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">

                                                            <TextBlock Text="{Binding DataContext.Loc_IngredientsHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9.5" FontWeight="SemiBold" Foreground="#E5C478" FontFamily="Consolas"/>

                                                            <TextBlock Text="{Binding DisplayIngredients}" FontSize="9.5" Foreground="#CBD5E1" FontFamily="Consolas" TextWrapping="Wrap"/>

                                                        </StackPanel>

                                                    </StackPanel>



                                                    <!-- Right: Interactive Two-Way CheckBox -->

                                                    <CheckBox Grid.Column="2" Style="{StaticResource CodexCheckBox}" IsChecked="{Binding IsUnlocked, Mode=TwoWay}"

                                                              VerticalAlignment="Center" Margin="10,0,4,0">

                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" Margin="2,0,0,0"/>

                                                    </CheckBox>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>



                            <!-- VIEW B: CRAFTING PERKS (BLACKSMITHING & ALCHEMY SKILL PERKS) -->

                            <ScrollViewer Visibility="{Binding IsCraftTabPerksSelected, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">

                                <ItemsControl ItemsSource="{Binding FilteredCraftingPerks}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type vm:CraftingSkillPerkViewModel}">

                                            <Border Background="#141822" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto"/> <!-- Badge & Icon -->

                                                        <ColumnDefinition Width="*"/>    <!-- Name & Description -->

                                                        <ColumnDefinition Width="Auto"/> <!-- CheckBox -->

                                                    </Grid.ColumnDefinitions>



                                                    <!-- Left: Icon & Skill Badge -->

                                                    <StackPanel Grid.Column="0" Width="100" VerticalAlignment="Center" Margin="0,0,10,0">

                                                        <Border CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Margin="0,0,0,4">

                                                            <Border.Style>

                                                                <Style TargetType="Border">

                                                                    <Setter Property="Background" Value="#C9A24D"/>

                                                                    <Style.Triggers>

                                                                        <DataTrigger Binding="{Binding SkillType}" Value="Alchemy">

                                                                            <Setter Property="Background" Value="#0284C7"/>

                                                                        </DataTrigger>

                                                                    </Style.Triggers>

                                                                </Style>

                                                            </Border.Style>

                                                            <TextBlock Text="{Binding SkillType}" Foreground="#090B0F" FontSize="8.5" FontWeight="ExtraBold" FontFamily="Consolas"/>

                                                        </Border>

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,4,0"/>

                                                            <TextBlock Text="{Binding Level, StringFormat='Stufe {0}'}" FontSize="9.5" FontWeight="Bold" Foreground="#F6E05E" FontFamily="Consolas" VerticalAlignment="Center"/>

                                                        </StackPanel>

                                                    </StackPanel>



                                                    <!-- Center: Perk Details -->

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="#F6E05E"/>

                                                        <TextBlock Text="{Binding DisplayDescription}" FontSize="10.5" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,3,0,0"/>

                                                    </StackPanel>



                                                    <!-- Right: Interactive Two-Way CheckBox -->

                                                    <CheckBox Grid.Column="2" Style="{StaticResource CodexCheckBox}" IsChecked="{Binding IsUnlocked, Mode=TwoWay}"

                                                              VerticalAlignment="Center" Margin="10,0,4,0">

                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" Margin="2,0,0,0"/>

                                                    </CheckBox>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </ScrollViewer>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>



        <!-- ===================================================================== -->

        <!-- ROW 4: BOTTOM STATUS BAR                                              -->

        <!-- ===================================================================== -->

        <Border Grid.Row="4" Background="#0B0D12" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="10,4">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>



                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                <CheckBox Grid.Column="1" Content="{Binding Loc_BackupCheck}" IsChecked="{Binding CreateBackup}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>

                <TextBlock Grid.Column="2" Text="{Binding SaveFilePath}" FontSize="10" Foreground="#64748B" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

            </Grid>

        </Border>



        <!-- ===================================================================== -->

        <!-- MODAL OVERLAY: FULL-FEATURED CODEX ITEM DATABASE SPAWNER              -->

        <!-- ===================================================================== -->

        <Grid Grid.Row="0" Grid.RowSpan="5" Background="#C8000000" Visibility="{Binding IsAddItemModalOpen, Converter={StaticResource BoolToVis}}">

            <Border Background="#121622" BorderBrush="#80C9A24D" BorderThickness="1.5" CornerRadius="12" Width="980" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18">

                <Border.Effect>

                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="10" Opacity="0.85"/>

                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" /> <!-- Header -->

                        <RowDefinition Height="Auto" /> <!-- Separator -->

                        <RowDefinition Height="*" />    <!-- Main 2-Column Body -->

                    </Grid.RowDefinitions>



                    <!-- 1. Header -->

                    <Grid Grid.Row="0" Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>



                        <StackPanel Grid.Column="0">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="✨ " FontSize="16" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Loc_SpawnerTitle}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                            </StackPanel>

                            <TextBlock Text="{Binding Loc_SpawnerSubtitle}" FontSize="11" Foreground="#94A3B8" Margin="22,2,0,0"/>

                        </StackPanel>



                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseAddItemModalCommand}" Style="{StaticResource DarkUtilityButton}" Padding="8,3" FontSize="12" VerticalAlignment="Top"/>

                    </Grid>



                    <Rectangle Grid.Row="1" Height="1" Fill="#25FFFFFF" Margin="0,0,0,12"/>



                    <!-- 2. Main 2-Column Body -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="580" />

                            <ColumnDefinition Width="14" />

                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>



                        <!-- LEFT: 5,604 Item Database Browser -->

                        <Grid Grid.Column="0">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" /> <!-- Category Pills -->

                                <RowDefinition Height="Auto" /> <!-- Search & Price Range & Sort -->

                                <RowDefinition Height="*" />    <!-- Virtualized ListView -->

                            </Grid.RowDefinitions>



                            <!-- Category Pills -->

                            <Border Grid.Row="0" Background="#0E121A" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,0,0,8">

                                <WrapPanel Orientation="Horizontal">

                                    <RadioButton Content="{Binding Loc_SpawnerCatAll}" GroupName="CodexCategories" IsChecked="{Binding IsCodexCatAll}" Command="{Binding SelectCodexCategoryCommand}" CommandParameter="All" Style="{StaticResource PillRadioButton}" Margin="2"/>

                                    <RadioButton Content="{Binding Loc_SpawnerCatWeapons}" GroupName="CodexCategories" IsChecked="{Binding IsCodexCatWeapons}" Command="{Binding SelectCodexCategoryCommand}" CommandParameter="Weapons" Style="{StaticResource PillRadioButton}" Margin="2"/>

                                    <RadioButton Content="{Binding Loc_SpawnerCatArmour}" GroupName="CodexCategories" IsChecked="{Binding IsCodexCatArmour}" Command="{Binding SelectCodexCategoryCommand}" CommandParameter="Armour" Style="{StaticResource PillRadioButton}" Margin="2"/>

                                    <RadioButton Content="{Binding Loc_SpawnerCatFood}" GroupName="CodexCategories" IsChecked="{Binding IsCodexCatFood}" Command="{Binding SelectCodexCategoryCommand}" CommandParameter="Food" Style="{StaticResource PillRadioButton}" Margin="2"/>

                                    <RadioButton Content="{Binding Loc_SpawnerCatBooks}" GroupName="CodexCategories" IsChecked="{Binding IsCodexCatBooks}" Command="{Binding SelectCodexCategoryCommand}" CommandParameter="Books" Style="{StaticResource PillRadioButton}" Margin="2"/>

                                    <RadioButton Content="{Binding Loc_SpawnerCatHerbs}" GroupName="CodexCategories" IsChecked="{Binding IsCodexCatHerbs}" Command="{Binding SelectCodexCategoryCommand}" CommandParameter="Herbs" Style="{StaticResource PillRadioButton}" Margin="2"/>

                                    <RadioButton Content="{Binding Loc_SpawnerCatHorse}" GroupName="CodexCategories" IsChecked="{Binding IsCodexCatHorse}" Command="{Binding SelectCodexCategoryCommand}" CommandParameter="Horse" Style="{StaticResource PillRadioButton}" Margin="2"/>

                                    <RadioButton Content="{Binding Loc_SpawnerCatOther}" GroupName="CodexCategories" IsChecked="{Binding IsCodexCatOther}" Command="{Binding SelectCodexCategoryCommand}" CommandParameter="Other" Style="{StaticResource PillRadioButton}" Margin="2"/>

                                </WrapPanel>

                            </Border>



                            <!-- Search, Price Range, Sort Toolbar -->

                            <Grid Grid.Row="1" Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="2.2*" />

                                    <ColumnDefinition Width="6" />

                                    <ColumnDefinition Width="1.5*" />

                                    <ColumnDefinition Width="6" />

                                    <ColumnDefinition Width="1.3*" />

                                </Grid.ColumnDefinitions>



                                <!-- Search Box -->

                                <Grid Grid.Column="0">

                                    <TextBox Text="{Binding CodexSearchFilter, UpdateSourceTrigger=PropertyChanged}"

                                             Background="#0A0D14" Foreground="#FFFFFF" BorderBrush="#2A2F40" Padding="24,5,6,5" FontSize="11"/>

                                    <TextBlock Text="🔍" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="7,0,0,0" IsHitTestVisible="False"/>

                                </Grid>



                                <!-- Price Filter ComboBox -->

                                <ComboBox Grid.Column="2" SelectedValue="{Binding CodexWorthFilter}" SelectedValuePath="Tag" Height="26" FontSize="11">

                                    <ComboBoxItem Content="{Binding Loc_PriceAll}" Tag="All"/>

                                    <ComboBoxItem Content="{Binding Loc_PriceCheap}" Tag="Under50"/>

                                    <ComboBoxItem Content="{Binding Loc_PriceMedium}" Tag="50to500"/>

                                    <ComboBoxItem Content="{Binding Loc_PriceValuable}" Tag="500to2500"/>

                                    <ComboBoxItem Content="{Binding Loc_PriceLegendary}" Tag="Above2500"/>

                                </ComboBox>



                                <!-- Sort Order ComboBox -->

                                <ComboBox Grid.Column="4" SelectedValue="{Binding CodexSortOption}" SelectedValuePath="Tag" Height="26" FontSize="11">

                                    <ComboBoxItem Content="{Binding Loc_SortNameAsc}" Tag="NameAsc"/>

                                    <ComboBoxItem Content="{Binding Loc_SortNameDesc}" Tag="NameDesc"/>

                                    <ComboBoxItem Content="{Binding Loc_SortPriceDesc}" Tag="PriceDesc"/>

                                    <ComboBoxItem Content="{Binding Loc_SortPriceAsc}" Tag="PriceAsc"/>

                                    <ComboBoxItem Content="{Binding Loc_SortWeight}" Tag="WeightDesc"/>

                                </ComboBox>

                            </Grid>



                            <!-- Virtualized Item List -->

                            <Border Grid.Row="2" Background="#0A0D14" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8">

                                <ListView ItemsSource="{Binding FilteredCodexItems}" SelectedItem="{Binding SelectedCodexItem}"

                                          Background="Transparent" BorderThickness="0" Foreground="#E2E8F0"

                                          VirtualizingStackPanel.IsVirtualizing="True"

                                          VirtualizingStackPanel.VirtualizationMode="Recycling"

                                          ScrollViewer.IsDeferredScrollingEnabled="False"

                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListView.ItemContainerStyle>

                                        <Style TargetType="ListViewItem">

                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                            <Setter Property="Background" Value="Transparent"/>

                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>

                                            <Setter Property="BorderBrush" Value="Transparent"/>

                                            <Setter Property="Padding" Value="8,4"/>

                                            <Setter Property="Margin" Value="0,1"/>

                                            <Setter Property="Cursor" Value="Hand"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="ListViewItem">

                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                                        </Border>

                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="IsMouseOver" Value="True">

                                                                <Setter TargetName="Bd" Property="Background" Value="#182030"/>

                                                            </Trigger>

                                                            <Trigger Property="IsSelected" Value="True">

                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E5C478"/>

                                                                <Setter TargetName="Bd" Property="Background" Value="#2D2415"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>

                                        <DataTemplate DataType="{x:Type services:GameItemCodexDefinition}">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="90" />

                                                    <ColumnDefinition Width="65" />

                                                    <ColumnDefinition Width="80" />

                                                </Grid.ColumnDefinitions>



                                                <!-- Name + Icon -->

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Text="{Binding InternalName}" Foreground="#64748B" FontSize="9" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>

                                                    </StackPanel>

                                                </StackPanel>



                                                <!-- Category Badge -->

                                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>

                                                </Border>



                                                <!-- Weight -->

                                                <TextBlock Grid.Column="2" Text="{Binding FormattedWeight}" Foreground="#94A3B8" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>



                                                <!-- Price -->

                                                <TextBlock Grid.Column="3" Text="{Binding FormattedPrice}" FontWeight="Bold" Foreground="#E5C478" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            </Grid>

                                        </DataTemplate>

                                    </ListView.ItemTemplate>

                                </ListView>

                            </Border>

                        </Grid>



                        <!-- RIGHT: Selected Item Card & Spawner Controls -->

                        <Border Grid.Column="2" Background="#141824" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10" Padding="14">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" /> <!-- Selected Item Preview Card -->

                                    <RowDefinition Height="Auto" /> <!-- Storage Destination Selector -->

                                    <RowDefinition Height="Auto" /> <!-- Quantity & Condition Steppers -->

                                    <RowDefinition Height="Auto" /> <!-- Stolen Flag -->

                                    <RowDefinition Height="*" />    <!-- Spacer -->

                                    <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->

                                </Grid.RowDefinitions>



                                <!-- 1. Selected Item Preview Card -->

                                <Border Grid.Row="0" Background="#1A2030" BorderBrush="#453B28" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,8">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>



                                            <!-- Large Icon -->

                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#242B3F" BorderBrush="#C9A24D" BorderThickness="1" Margin="0,0,10,0">

                                                <TextBlock Text="{Binding SelectedCodexItem.Icon}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            </Border>



                                            <!-- Title & Category -->

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <TextBlock Text="{Binding SelectedCodexItem.DisplayName, FallbackValue='Kein Gegenstand gewählt'}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">

                                                    <Border Background="#25C9A24D" BorderBrush="#60C9A24D" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,6,0">

                                                        <TextBlock Text="{Binding SelectedCodexItem.Category}" FontSize="9" FontWeight="Bold" Foreground="#E5C478"/>

                                                    </Border>

                                                    <TextBlock Text="{Binding SelectedCodexItem.Tag}" FontSize="9" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center"/>

                                                </StackPanel>

                                            </StackPanel>

                                        </Grid>



                                        <Rectangle Height="1" Fill="#20FFFFFF" Margin="0,0,0,8"/>



                                        <!-- Stats Badges -->

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding Loc_BasePrice}" FontSize="9" Foreground="#94A3B8"/>

                                                <TextBlock Text="{Binding SelectedCodexItem.FormattedPrice}" FontWeight="Bold" Foreground="#E5C478" FontSize="13" FontFamily="Consolas"/>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1">

                                                <TextBlock Text="{Binding Loc_Weight}" FontSize="9" Foreground="#94A3B8"/>

                                                <TextBlock Text="{Binding SelectedCodexItem.FormattedWeight}" FontWeight="Bold" Foreground="#CBD5E1" FontSize="13" FontFamily="Consolas"/>

                                            </StackPanel>

                                        </Grid>



                                        <!-- Monospace GUID -->

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">

                                            <TextBlock Text="GUID: " FontSize="9" Foreground="#64748B"/>

                                            <TextBlock Text="{Binding SelectedCodexItem.Guid}" FontSize="9" Foreground="#94A3B8" FontFamily="Consolas"/>

                                        </StackPanel>

                                    </StackPanel>

                                </Border>



                                <!-- 2. Storage Destination Selector -->

                                <StackPanel Grid.Row="1" Margin="0,0,0,14">

                                    <TextBlock Text="{Binding Loc_SpawnerTargetStorage}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,6"/>

                                    <UniformGrid Rows="1">

                                        <RadioButton Content="{Binding Loc_TargetStorageInventory}" GroupName="SpawnTargets" IsChecked="{Binding IsSpawnTargetInventory}" Command="{Binding SelectSpawnTargetStorageCommand}" CommandParameter="Inventory" Style="{StaticResource PillRadioButton}" Margin="0,0,4,0"/>

                                        <RadioButton Content="{Binding Loc_TargetStorageStash}" GroupName="SpawnTargets" IsChecked="{Binding IsSpawnTargetStash}" Command="{Binding SelectSpawnTargetStorageCommand}" CommandParameter="Stash" Style="{StaticResource PillRadioButton}" Margin="0,0,4,0"/>

                                        <RadioButton Content="{Binding Loc_TargetStorageHorse}" GroupName="SpawnTargets" IsChecked="{Binding IsSpawnTargetHorse}" Command="{Binding SelectSpawnTargetStorageCommand}" CommandParameter="Horse" Style="{StaticResource PillRadioButton}"/>

                                    </UniformGrid>

                                </StackPanel>



                                <!-- 3. Quantity & Condition Steppers -->

                                <StackPanel Grid.Row="2" Margin="0,0,0,12">

                                    <!-- Quantity -->

                                    <TextBlock Text="{Binding Loc_SpawnerQuantity}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,4"/>

                                    <Grid Margin="0,0,0,6">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="65" />

                                            <ColumnDefinition Width="6" />

                                            <ColumnDefinition Width="*" />

                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Text="{Binding SpawnQuantity, UpdateSourceTrigger=PropertyChanged}"

                                                 FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextAlignment="Center" VerticalAlignment="Center" Padding="4"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">

                                            <Button Command="{Binding AddSpawnQuantityCommand}" CommandParameter="-1" Content="-1" Style="{StaticResource DarkUtilityButton}" Margin="0,0,3,0" Padding="6,2" FontSize="10"/>

                                            <Button Command="{Binding AddSpawnQuantityCommand}" CommandParameter="1" Content="+1" Style="{StaticResource DarkUtilityButton}" Margin="0,0,3,0" Padding="6,2" FontSize="10"/>

                                            <Button Command="{Binding AddSpawnQuantityCommand}" CommandParameter="5" Content="+5" Style="{StaticResource DarkUtilityButton}" Margin="0,0,3,0" Padding="6,2" FontSize="10"/>

                                            <Button Command="{Binding AddSpawnQuantityCommand}" CommandParameter="25" Content="+25" Style="{StaticResource DarkUtilityButton}" Margin="0,0,3,0" Padding="6,2" FontSize="10"/>

                                            <Button Command="{Binding AddSpawnQuantityCommand}" CommandParameter="100" Content="+100" Style="{StaticResource DarkUtilityButton}" Padding="6,2" FontSize="10"/>

                                        </StackPanel>

                                    </Grid>



                                    <!-- Condition -->

                                    <Grid Margin="0,6,0,0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc_SpawnerCondition}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>

                                        <TextBlock Grid.Column="1" Text="{Binding SpawnCondition, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" FontFamily="Consolas"/>

                                    </Grid>

                                    <Slider Minimum="0" Maximum="100" Value="{Binding SpawnCondition, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>

                                </StackPanel>



                                <!-- 4. Stolen Flag Checkbox -->

                                <CheckBox Grid.Row="3" Content="{Binding Loc_SpawnerStolen}" IsChecked="{Binding SpawnIsStolen}"

                                          Foreground="#FB7185" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,14"/>



                                <!-- 5. Bottom Action Buttons -->

                                <Grid Grid.Row="5">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="10" />

                                        <ColumnDefinition Width="1.5*" />

                                    </Grid.ColumnDefinitions>



                                    <Button Grid.Column="0" Content="{Binding Loc_SpawnerCancel}" Command="{Binding CloseAddItemModalCommand}" Style="{StaticResource DarkUtilityButton}" Padding="10,8" FontSize="11"/>

                                    <Button Grid.Column="2" Content="{Binding Loc_SpawnerAdd}" Command="{Binding ConfirmAddItemCommand}" Style="{StaticResource GoldButton}" Padding="12,8" FontSize="12" FontWeight="Bold"/>

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <!-- ===================================================================== -->
        <!-- MODAL OVERLAY: PAPERDOLL SLOT EQUIPMENT SELECTOR                      -->
        <!-- ===================================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Background="#D0000000" Visibility="{Binding IsSlotPickerModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#121622" BorderBrush="#80C9A24D" BorderThickness="1.5" CornerRadius="12" Width="960" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="10" Opacity="0.85"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header & Current Slot -->
                        <RowDefinition Height="Auto" /> <!-- Separator -->
                        <RowDefinition Height="Auto" /> <!-- Source Pills & Search -->
                        <RowDefinition Height="*" />    <!-- Main 2-Column: Item list + Item Preview Card -->
                    </Grid.RowDefinitions>

                    <!-- 1. Header with Slot Title, Current Item & Unequip Action -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Slot Title & Icon -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPaperdollSlot.Icon, FallbackValue='🛡️'}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Loc_SlotPickerTitle}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Border Background="#25C9A24D" BorderBrush="#60C9A24D" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedPaperdollSlot.DisplayLabel}" FontSize="11" FontWeight="Bold" Foreground="#E5C478"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Loc_SlotPickerSubtitle}" FontSize="11" Foreground="#94A3B8" Margin="26,2,0,0"/>
                        </StackPanel>

                        <!-- Current Equipment Status & Unequip -->
                        <Border Grid.Column="1" Background="#182030" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Loc_SlotPickerCurrent}" FontSize="11" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SlotPickerCurrentItemName}" FontSize="11" FontWeight="Bold" Foreground="#FDE047" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Button Content="{Binding Loc_SlotPickerUnequip}" Command="{Binding UnequipSlotCommand}" Style="{StaticResource DarkUtilityButton}" Padding="8,3" FontSize="10" Foreground="#FB7185"/>
                            </StackPanel>
                        </Border>

                        <!-- Close (X) Button -->
                        <Button Grid.Column="2" Content="✕" Command="{Binding CloseSlotPickerModalCommand}" Style="{StaticResource DarkUtilityButton}" Padding="9,4" FontSize="13" VerticalAlignment="Top"/>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="#25FFFFFF" Margin="0,0,0,10"/>

                    <!-- 2. Source Pills (Inventory vs All Game Items) & Search Filter -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Source Radio Pills -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="{Binding Loc_SlotPickerSourceInv}" GroupName="SlotPickerSources" IsChecked="{Binding IsSlotPickerSourceInventory, Mode=TwoWay}" Command="{Binding SelectSlotPickerSourceCommand}" CommandParameter="Inventory" Style="{StaticResource PillRadioButton}" Margin="0,0,6,0"/>
                            <RadioButton Content="{Binding Loc_SlotPickerSourceAll}" GroupName="SlotPickerSources" IsChecked="{Binding IsSlotPickerSourceAll, Mode=TwoWay}" Command="{Binding SelectSlotPickerSourceCommand}" CommandParameter="All" Style="{StaticResource PillRadioButton}"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <Grid Grid.Column="1" Margin="14,0">
                            <TextBox Text="{Binding SlotPickerSearchText, UpdateSourceTrigger=PropertyChanged}" Background="#0A0D14" Foreground="#FFFFFF" BorderBrush="#2A2F40" Padding="24,5,6,5" FontSize="11" VerticalContentAlignment="Center"/>
                            <TextBlock Text="🔍" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="7,0,0,0" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Item Count text -->
                        <TextBlock Grid.Column="2" Text="{Binding SlotPickerItemCountText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 3. Main 2-Column: Item list + Item Preview Card -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="580" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Filtered Item List -->
                        <Border Grid.Column="0" Background="#0A0D14" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8">
                            <ListView ItemsSource="{Binding SlotPickerItems}" SelectedItem="{Binding SelectedSlotPickerItem}"
                                      Background="Transparent" BorderThickness="0" Foreground="#E2E8F0"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.IsDeferredScrollingEnabled="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Margin" Value="2,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#182030"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E5C478"/>
                                                            <Setter TargetName="Bd" Property="Background" Value="#2D2415"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SlotPickerItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="65" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Name + Icon -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                        <Border Background="{Binding SourceBadgeBackground}" BorderBrush="{Binding SourceBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding SourceBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding SourceBadgeForeground}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding SubCategory}" FontSize="9" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Tier / Power Badge -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding TierDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FCD34D" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding ConditionDisplay}" FontSize="9" Foreground="#94A3B8" TextAlignment="Right" Visibility="{Binding IsInPlayerInventory, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <!-- Price -->
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedPrice}" FontWeight="SemiBold" FontSize="11" Foreground="#E5C478" FontFamily="Consolas" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>

                                            <!-- Weight -->
                                            <TextBlock Grid.Column="3" Text="{Binding FormattedWeight}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas" VerticalAlignment="Center" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <!-- RIGHT: Item Inspector Card & Equip Action -->
                        <Border Grid.Column="2" Background="#0E121A" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Details Area -->
                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Header: Big Icon & Name -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="46" Height="46" Background="#182030" BorderBrush="#40C9A24D" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedSlotPickerItem.Icon, FallbackValue='🛡️'}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedSlotPickerItem.Name, FallbackValue='Kein Gegenstand gewählt'}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Border Background="{Binding SelectedSlotPickerItem.SourceBadgeBackground}" BorderBrush="{Binding SelectedSlotPickerItem.SourceBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding SelectedSlotPickerItem.SourceBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding SelectedSlotPickerItem.SourceBadgeForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedSlotPickerItem.TierDisplay}" FontSize="9" FontWeight="Bold" Foreground="#FCD34D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SelectedSlotPickerItem.SubCategory}" FontSize="9" Foreground="#64748B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="#20FFFFFF" Margin="0,0,0,12"/>

                                        <!-- Stats Grid -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Loc_SlotPickerPrice}" FontSize="9" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding SelectedSlotPickerItem.FormattedPrice, FallbackValue='- Gr.'}" FontWeight="Bold" Foreground="#E5C478" FontSize="14" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Loc_SlotPickerWeight}" FontSize="9" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding SelectedSlotPickerItem.FormattedWeight, FallbackValue='- kg'}" FontWeight="Bold" Foreground="#CBD5E1" FontSize="14" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Tier & Category Info -->
                                        <Border Background="#141822" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Loc_SlotPickerTier}" FontSize="10" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding SelectedSlotPickerItem.TierDisplay, FallbackValue='Standard'}" FontSize="10" FontWeight="Bold" Foreground="#FCD34D" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Loc_SlotPickerCategory}" FontSize="10" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding SelectedSlotPickerItem.Category, FallbackValue='-'}" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Loc_SlotPickerType}" FontSize="10" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding SelectedSlotPickerItem.SubCategory, FallbackValue='-'}" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Visibility="{Binding SelectedSlotPickerItem.IsInPlayerInventory, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Loc_SlotPickerCondition}" FontSize="10" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding SelectedSlotPickerItem.ConditionDisplay, FallbackValue='100%'}" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Slot Target Info -->
                                        <Border Background="#18241A" BorderBrush="#304ADE80" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <TextBlock Text="{Binding Loc_SlotPickerOutfitNotice}" FontSize="10" Foreground="#86EFAC" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Bottom Action Buttons -->
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="{Binding Loc_SlotPickerCancel}" Command="{Binding CloseSlotPickerModalCommand}" Style="{StaticResource DarkUtilityButton}" Padding="10,8" FontSize="11"/>
                                    <Button Grid.Column="2" Content="{Binding Loc_SlotPickerEquip}" Command="{Binding EquipSelectedSlotItemCommand}" Style="{StaticResource GoldButton}" Padding="12,8" FontSize="12" FontWeight="Bold"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>



    </Grid>

</Border>

</Window>