    <!-- MAIN WINDOW ROOT BORDER WITH DARK GOTHIC ACCENT BORDER -->

    <Border x:Name="RootBorder" Background="#090B0F" BorderBrush="#352F22">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" /> <!-- Row 0: Custom Title Bar & Window Controls -->

                <RowDefinition Height="Auto" /> <!-- Row 1: Top Application Bar (Toolbar) -->

                <RowDefinition Height="Auto" /> <!-- Row 2: Top Main Navigation Ribbon Bar (V2) -->

                <RowDefinition Height="*" />    <!-- Row 3: Main Workspace Content (4 Switchable Tabs) -->

                <RowDefinition Height="Auto" /> <!-- Row 4: Status Notification Footer -->

            </Grid.RowDefinitions>



            <!-- ===================================================================== -->

            <!-- ROW 0: CUSTOM TITLE BAR & WINDOW CONTROLS                             -->

            <!-- ===================================================================== -->

            <Border Grid.Row="0" Background="#07090D" BorderBrush="#30C9A24D" BorderThickness="0,0,0,1" Height="34">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto" /> <!-- Logo & App Title -->

                        <ColumnDefinition Width="*" />    <!-- Draggable Middle Area with active save name & sync indicator -->

                        <ColumnDefinition Width="Auto" /> <!-- Window Controls (─, □, ✕) -->

                    </Grid.ColumnDefinitions>



                    <!-- Left: Emblem & Title -->

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">

                        <Grid Width="20" Height="20" Margin="0,0,8,0">

                            <Border CornerRadius="4" BorderBrush="#80C9A24D" BorderThickness="1">

                                <Border.Background>

                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                        <GradientStop Color="#8C1D24" Offset="0"/>

                                        <GradientStop Color="#4D0E12" Offset="1"/>

                                    </LinearGradientBrush>

                                </Border.Background>

                                <Path Data="M12,2 L4,5 L4,11.09 C4,16.14 7.41,20.85 12,22 C16.59,20.85 20,16.14 20,11.09 L20,5 L12,2 Z"

                                      Stroke="#E5C478" StrokeThickness="1" Fill="#20C9A24D"

                                      Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                        <TextBlock Text="KCD " FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                        <TextBlock Text="II" FontSize="12" FontWeight="Bold" Foreground="#C9A24D" VerticalAlignment="Center"/>

                        <TextBlock Text=" // SAVE EDITOR" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>

                        <Border Background="#20C9A24D" BorderBrush="#40C9A24D" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Center">

                            <TextBlock Text="v2.5.0-PRO" FontSize="9" FontWeight="Bold" Foreground="#E5C478" FontFamily="Consolas"/>

                        </Border>

                    </StackPanel>



                    <!-- Center: Active Save Filename Display (Draggable) -->

                    <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="❖ " Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding SelectedSaveItem.FileName, FallbackValue='Kein Spielstand geladen'}"

                                       Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>

                            <TextBlock Text=" — " Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding SelectedSaveItem.LevelName, FallbackValue=''}"

                                       Foreground="#E5C478" FontSize="11" VerticalAlignment="Center"/>

                            <TextBlock Text=" • " Foreground="#475569" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>

                            <TextBlock Text="{Binding StatusSyncText}" Foreground="{Binding StatusSyncColor}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>

                        </StackPanel>

                    </Grid>



                    <!-- Right: Custom Window Controls (KCD Gothic Accent) -->

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">

                        <Button Click="BtnMinimize_Click" Style="{StaticResource WindowControlButton}" ToolTip="{Binding Loc_WindowMinTip}">

                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                        </Button>

                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource WindowControlButton}" ToolTip="{Binding Loc_WindowMaxTip}">

                            <Path x:Name="MaximizeIcon" Data="M0.5,0.5 L8.5,0.5 L8.5,8.5 L0.5,8.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                        </Button>

                        <Button Click="BtnClose_Click" Style="{StaticResource WindowCloseButton}" ToolTip="{Binding Loc_WindowCloseTip}">

                            <Path Data="M0.5,0.5 L8.5,8.5 M8.5,0.5 L0.5,8.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>



            <!-- ===================================================================== -->

            <!-- ROW 1: TOP APPLICATION BAR (TOOLBAR)                                  -->

            <!-- ===================================================================== -->

            <Border Grid.Row="1" Background="#0D1017" BorderBrush="#40C9A24D" BorderThickness="0,0,0,1" Padding="12,7">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />    <!-- Active Save Slot Selector -->

                        <ColumnDefinition Width="Auto" /> <!-- Quick Mod Actions & Export -->

                    </Grid.ColumnDefinitions>



                    <!-- Left: Active Save Slot Selector Card (High Contrast) -->

                    <Border Grid.Column="0" Background="#11151F" BorderBrush="#424E66" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>



                            <!-- Platform Icon Badge on the left -->
                            <Border Grid.Column="0" CornerRadius="6" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Background="{Binding CurrentPlatformBadgeBackground}"
                                    BorderBrush="{Binding CurrentPlatformBadgeBorder}"
                                    BorderThickness="1.5"
                                    ToolTip="{Binding CurrentPlatformTooltip}">
                                <TextBlock Text="{Binding CurrentPlatformIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                <!-- Header row with Active Save label, Platform badge, and Platform Switchers -->
                                <Grid Margin="2,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Label -->
                                    <TextBlock Grid.Column="0" Text="{Binding Loc_ActiveSave}" FontSize="10" FontWeight="Bold" Foreground="#FCD34D" VerticalAlignment="Center"/>

                                    <!-- Current Platform Badge Indicator -->
                                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                            Background="{Binding CurrentPlatformBadgeBackground}"
                                            BorderBrush="{Binding CurrentPlatformBadgeBorder}"
                                            BorderThickness="1"
                                            ToolTip="{Binding CurrentPlatformTooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentPlatformIcon}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding CurrentPlatformName}" FontSize="9" FontWeight="Bold" Foreground="{Binding CurrentPlatformBadgeForeground}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Platform Switcher Buttons (Xbox vs Steam) -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                        <!-- Xbox Switch Button -->
                                        <Button Command="{Binding SwitchToXboxCommand}"
                                                Visibility="{Binding HasXboxSavesVisibility}"
                                                ToolTip="{Binding Loc_SwitchToXboxTip}"
                                                Cursor="Hand" Margin="0,0,4,0" Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="4" BorderThickness="1" Padding="6,2"
                                                            Background="{Binding XboxButtonBackground}"
                                                            BorderBrush="{Binding XboxButtonBorder}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🎮" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Xbox" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding XboxButtonForeground}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding XboxSavesCount, StringFormat=' ({0})'}" FontSize="9"
                                                                       Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Steam Switch Button -->
                                        <Button Command="{Binding SwitchToSteamCommand}"
                                                Visibility="{Binding HasSteamSavesVisibility}"
                                                ToolTip="{Binding Loc_SwitchToSteamTip}"
                                                Cursor="Hand" Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="4" BorderThickness="1" Padding="6,2"
                                                            Background="{Binding SteamButtonBackground}"
                                                            BorderBrush="{Binding SteamButtonBorder}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="💨" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Steam" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding SteamButtonForeground}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding SteamSavesCount, StringFormat=' ({0})'}" FontSize="9"
                                                                       Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ComboBox ItemsSource="{Binding AvailableSaves}" SelectedItem="{Binding SelectedSaveItem}"
                                          Background="#0B0E16" BorderBrush="#C9A24D" BorderThickness="1" MinHeight="32" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SaveGameItemViewModel}">
                                            <Grid Margin="2,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Platform Badge (e.g. 🎮 XBOX or 💨 STEAM) -->
                                                <Border Grid.Column="0" Background="{Binding PlatformBadgeColor}" CornerRadius="3" Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PlatformIcon}" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PlatformText}" Foreground="#FFFFFF" FontSize="8" FontWeight="ExtraBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Category Badge -->
                                                <Border Grid.Column="1" Background="{Binding SaveTypeBadgeColor}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SaveType}" Foreground="#090B0F" FontSize="9" FontWeight="ExtraBold" FontFamily="Consolas"/>
                                                </Border>

                                                <!-- File Name in crisp bright white -->
                                                <TextBlock Grid.Column="2" Text="{Binding FileName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Region & Quest in radiant gold / crisp text -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="— " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding LevelName}" Foreground="#FCD34D" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" (" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding QuestName}" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text=")" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Playtime in amber gold -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="⏱ " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PlaytimeFormatted}" Foreground="#FDE047" FontWeight="ExtraBold" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>



                            <Button Grid.Column="2" Content="{Binding Loc_OpenSave}" Command="{Binding OpenSaveCommand}"

                                    Style="{StaticResource DarkUtilityButton}" Margin="8,0,4,0" ToolTip="{Binding Loc_OpenSaveTip}"

                                    Background="#181F2C" BorderBrush="#424E66" BorderThickness="1"/>

                            <Button Grid.Column="3" Content="{Binding Loc_AutoDetect}" Command="{Binding AutoDetectCommand}"

                                    Style="{StaticResource DarkUtilityButton}" ToolTip="{Binding Loc_AutoDetectTip}"

                                    Background="#181F2C" BorderBrush="#424E66" BorderThickness="1"/>

                        </Grid>

                    </Border>



                    <!-- Right: Game Exe Selector, Language Selector, Quick Mods & Primary Save Button -->

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Game Exe / Directory Selector -->

                        <Button Command="{Binding SelectGameExeCommand}" Style="{StaticResource DarkUtilityButton}" Margin="0,0,8,0"

                                ToolTip="{Binding GameContentPathDisplay}"

                                Background="#11151F" BorderBrush="#424E66" BorderThickness="1">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,1">

                                <TextBlock Text="🎮 " FontSize="12" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding ActiveGameExeButtonLabel}" Foreground="#FCD34D" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>



                        <!-- Language Selection Card (High Contrast with National Flags) -->

                        <Border Background="#11151F" BorderBrush="#424E66" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <TextBlock Text="🌐" FontSize="13" Foreground="#FCD34D" VerticalAlignment="Center" Margin="3,0,6,0"/>

                                <ComboBox ItemsSource="{Binding AvailableLanguages}"

                                          SelectedItem="{Binding SelectedLanguage}"

                                          Width="185" MinHeight="28"

                                          Background="#0B0E16" BorderBrush="#C9A24D" BorderThickness="1"

                                          ToolTip="{Binding Loc_LanguageTip}">

                                    <ComboBox.ItemTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <TextBlock Text="{Binding FlagEmoji}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding DisplayName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </ComboBox.ItemTemplate>

                                </ComboBox>

                            </StackPanel>

                        </Border>



                        <!-- Quick Mod: 100% Zustand & Reinigen -->

                        <Button Command="{Binding RepairAllCommand}" Style="{StaticResource DarkUtilityButton}" Margin="0,0,6,0" ToolTip="{Binding Loc_RepairAllTip}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="🔨" Foreground="#4ADE80" Margin="0,0,5,0"/>

                                <TextBlock Text="{Binding Loc_RepairAll}" FontWeight="SemiBold"/>

                            </StackPanel>

                        </Button>



                        <!-- Quick Mod: Diebesgut-Tag entfernen -->

                        <Button Command="{Binding ClearStolenCommand}" Style="{StaticResource DarkUtilityButton}" Margin="0,0,6,0" ToolTip="{Binding Loc_LegalizeTip}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="🛡️" Foreground="#38BDF8" Margin="0,0,5,0"/>

                                <TextBlock Text="{Binding Loc_Legalize}" FontWeight="SemiBold"/>

                            </StackPanel>

                        </Button>



                        <!-- Quick Mod: Max Werte (30) -->

                        <Button Command="{Binding MaxAllStatsCommand}" Style="{StaticResource DarkUtilityButton}" Margin="0,0,8,0" ToolTip="{Binding Loc_MaxStatsTip}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="⚡" Foreground="#FCD34D" Margin="0,0,5,0"/>

                                <TextBlock Text="{Binding Loc_MaxStats}" FontWeight="SemiBold"/>

                            </StackPanel>

                        </Button>



                        <!-- Primary Export Button -->

                        <Button Command="{Binding SaveCommand}" Style="{StaticResource GoldButton}" ToolTip="{Binding Loc_ExportSaveTip}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="💾" Foreground="#0D1017" Margin="0,0,6,0"/>

                                <TextBlock Text="{Binding Loc_ExportSave}" FontWeight="Bold"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>



        <!-- ===================================================================== -->

        <!-- ROW 2: TOP MAIN NAVIGATION TABS (AUTHENTIC KCD RIBBON BAR - V2)       -->

        <!-- ===================================================================== -->

        <Border Grid.Row="2" Background="#0B0E14" BorderBrush="#35C9A24D" BorderThickness="0,0,0,1" Padding="12,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                <Button Command="{Binding SwitchMainTabCommand}" CommandParameter="Questlog" Style="{StaticResource NavTabQuestlogStyle}">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="📜" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Loc_NavQuestlog}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button Command="{Binding SwitchMainTabCommand}" CommandParameter="Inventar" Style="{StaticResource NavTabInventarStyle}">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🛡️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Loc_NavInventar}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button Command="{Binding SwitchMainTabCommand}" CommandParameter="Spieler" Style="{StaticResource NavTabSpielerStyle}">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="👤" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Loc_NavSpieler}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button Command="{Binding SwitchMainTabCommand}" CommandParameter="Handwerk" Style="{StaticResource NavTabHandwerkStyle}">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="⚒️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Loc_NavHandwerk}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>



        <!-- ===================================================================== -->

        <!-- ROW 3: MAIN WORKSPACE CONTENT (4 SWITCHABLE TABS)                     -->

        <!-- ===================================================================== -->

        <Grid Grid.Row="3" Margin="10,6,10,8">



            <!-- ================================================================= -->

            <!-- TAB 1: INVENTAR & AUSRÜSTUNG (HENRY & PEBBLES)                   -->

            <!-- ================================================================= -->

            <Grid Visibility="{Binding SelectedMainTab, Converter={StaticResource EqToVis}, ConverterParameter='Inventar'}">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="7*" MinWidth="600"/>

                    <ColumnDefinition Width="8"/> <!-- Spacer -->

                    <ColumnDefinition Width="5*" MinWidth="480"/>

                </Grid.ColumnDefinitions>



            <!-- ================================================================= -->

            <!-- LEFT / CENTER PANEL: INVENTORY & CODEX DATABASE                   -->

            <!-- ================================================================= -->

            <Border Grid.Column="0" Background="#12151C" BorderBrush="#352F22" BorderThickness="1" CornerRadius="10">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" /> <!-- 0. Storage Switcher Bar (Inventar vs. Truhe vs. Pferd vs. Alle) -->

                        <RowDefinition Height="Auto" /> <!-- 1. 9 Category Shield Tabs -->

                        <RowDefinition Height="Auto" /> <!-- 2. Search & Filter Toolbar -->

                        <RowDefinition Height="Auto" /> <!-- 3. Table Column Header Bar -->

                        <RowDefinition Height="*" />    <!-- 4. Grouped Inventory List -->

                        <RowDefinition Height="Auto" /> <!-- 5. Live Item Inspector Drawer -->

                        <RowDefinition Height="Auto" /> <!-- 6. Groschen & Carry Weight Footer -->

                    </Grid.RowDefinitions>



                    <!-- 0. STORAGE CONTAINER SWITCHER (HENRY INVENTORY vs. STASH vs. HORSE vs. ALL) -->

                    <Border Grid.Row="0" Background="#0A0C11" BorderBrush="#352F22" BorderThickness="0,0,0,1" Padding="8,6">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>



                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                <TextBlock Text="{Binding Loc_StorageHeader}" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>



                                <!-- 🎒 SPIELER-INVENTAR (HENRY) -->

                                <Button Command="{Binding SelectStorageFilterCommand}" CommandParameter="Inventory" Margin="0,0,6,0" Cursor="Hand" Background="Transparent" BorderThickness="0">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="bd" CornerRadius="6" Padding="10,4" Background="#141822" BorderBrush="#25FFFFFF" BorderThickness="1">

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="🎒 " FontSize="12"/>

                                                    <TextBlock Text="{Binding DataContext.Loc_StorageInventory, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>

                                                    <Border Background="#10B981" CornerRadius="3" Padding="4,0" Margin="6,0,0,0">

                                                        <TextBlock Text="{Binding DataContext.CountInventoryItems, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold" Foreground="#042F1E" FontFamily="Consolas"/>

                                                    </Border>

                                                </StackPanel>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <DataTrigger Binding="{Binding DataContext.IsStorageFilterInventory, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                                    <Setter TargetName="bd" Property="Background" Value="#1A2D23"/>

                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#10B981"/>

                                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>

                                                </DataTrigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>



                                <!-- 📦 SPIELER-TRUHE (STASH) -->

                                <Button Command="{Binding SelectStorageFilterCommand}" CommandParameter="Stash" Margin="0,0,6,0" Cursor="Hand" Background="Transparent" BorderThickness="0">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="bd" CornerRadius="6" Padding="10,4" Background="#141822" BorderBrush="#25FFFFFF" BorderThickness="1">

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="📦 " FontSize="12"/>

                                                    <TextBlock Text="{Binding DataContext.Loc_StorageStash, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>

                                                    <Border Background="#8B5CF6" CornerRadius="3" Padding="4,0" Margin="6,0,0,0">

                                                        <TextBlock Text="{Binding DataContext.CountStashItems, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold" Foreground="#2E1065" FontFamily="Consolas"/>

                                                    </Border>

                                                </StackPanel>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <DataTrigger Binding="{Binding DataContext.IsStorageFilterStash, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                                    <Setter TargetName="bd" Property="Background" Value="#2D1B47"/>

                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#A855F7"/>

                                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>

                                                </DataTrigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>



                                <!-- 🐎 PFERD -->

                                <Button Command="{Binding SelectStorageFilterCommand}" CommandParameter="Horse" Margin="0,0,6,0" Cursor="Hand" Background="Transparent" BorderThickness="0">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="bd" CornerRadius="6" Padding="10,4" Background="#141822" BorderBrush="#25FFFFFF" BorderThickness="1">

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="🐎 " FontSize="12"/>

                                                    <TextBlock Text="{Binding DataContext.Loc_StorageHorse, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>

                                                    <Border Background="#F59E0B" CornerRadius="3" Padding="4,0" Margin="6,0,0,0">

                                                        <TextBlock Text="{Binding DataContext.CountHorseItems, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold" Foreground="#451A03" FontFamily="Consolas"/>

                                                    </Border>

                                                </StackPanel>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <DataTrigger Binding="{Binding DataContext.IsStorageFilterHorse, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                                    <Setter TargetName="bd" Property="Background" Value="#332410"/>

                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#F59E0B"/>

                                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>

                                                </DataTrigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>



                                <!-- 🌐 ALLE -->

                                <Button Command="{Binding SelectStorageFilterCommand}" CommandParameter="All" Cursor="Hand" Background="Transparent" BorderThickness="0">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="bd" CornerRadius="6" Padding="10,4" Background="#141822" BorderBrush="#25FFFFFF" BorderThickness="1">

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="🌐 " FontSize="12"/>

                                                    <TextBlock Text="{Binding DataContext.Loc_StorageAll, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0"/>

                                                    <Border Background="#334155" CornerRadius="3" Padding="4,0" Margin="6,0,0,0">

                                                        <TextBlock Text="{Binding DataContext.CountAllItems, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC" FontFamily="Consolas"/>

                                                    </Border>

                                                </StackPanel>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <DataTrigger Binding="{Binding DataContext.IsStorageFilterAll, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">

                                                    <Setter TargetName="bd" Property="Background" Value="#242B3B"/>

                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>

                                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>

                                                </DataTrigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- 1. 9 KCD2 Category Shield Tabs -->

                    <Border Grid.Row="1" Background="#0E1117" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="6,6,6,4">

                        <ItemsControl ItemsSource="{Binding CategoryTabs}">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <UniformGrid Rows="1" />

                                </ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate DataType="{x:Type vm:CategoryTabViewModel}">

                                    <Button Command="{Binding DataContext.SelectCategoryTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding Id}" Margin="2,0" Background="Transparent" BorderThickness="0" Cursor="Hand">

                                        <Button.Template>

                                            <ControlTemplate TargetType="Button">

                                                <Border x:Name="tabBd" CornerRadius="6" Padding="4,5" Background="#141822" BorderBrush="#25FFFFFF" BorderThickness="1">

                                                    <StackPanel HorizontalAlignment="Center">

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                            <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,4,0"/>

                                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>

                                                        </StackPanel>

                                                        <!-- Item Count Badge -->

                                                        <Border Background="#1A202C" CornerRadius="3" Padding="4,1" Margin="0,3,0,0" HorizontalAlignment="Center">

                                                            <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Bold" Foreground="#C9A24D" FontFamily="Consolas"/>

                                                        </Border>

                                                    </StackPanel>

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">

                                                        <Setter TargetName="tabBd" Property="Background" Value="#1E2433"/>

                                                        <Setter TargetName="tabBd" Property="BorderBrush" Value="#C9A24D"/>

                                                    </Trigger>

                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">

                                                        <Setter TargetName="tabBd" Property="Background" Value="#2A2212"/>

                                                        <Setter TargetName="tabBd" Property="BorderBrush" Value="#E5C478"/>

                                                        <Setter TargetName="tabBd" Property="BorderThickness" Value="1.5"/>

                                                    </DataTrigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Button.Template>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Border>



                    <!-- 2. Search, Filter & Add Item Toolbar -->

                    <Border Grid.Row="2" Background="#141821" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="8,6">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>



                            <!-- Search Input -->

                            <Grid Grid.Column="0" Margin="0,0,8,0">

                                <TextBox Text="{Binding InventorySearchFilter, UpdateSourceTrigger=PropertyChanged}"

                                         Background="#0C0E14" Foreground="#FFFFFF" BorderBrush="#2A2F40" Padding="26,6,8,6" FontSize="12"

                                         ToolTip="{Binding Loc_SearchPlaceholder}"/>

                                <TextBlock Text="🔍" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>

                            </Grid>



                            <!-- Filter Equipped Only Toggle -->

                            <Button Grid.Column="1" Command="{Binding ToggleFilterEquippedCommand}" Style="{StaticResource DarkUtilityButton}" Margin="0,0,6,0">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,5,0"

                                            Background="{Binding FilterEquippedOnly, Converter={StaticResource EqToBrush}, ConverterParameter='True'}"/>

                                    <TextBlock Text="{Binding Loc_FilterEquipped}" FontSize="11"/>

                                </StackPanel>

                            </Button>



                            <!-- Add New Item from Codex Spawner -->

                            <Button Grid.Column="2" Command="{Binding OpenAddItemModalCommand}" Style="{StaticResource CrimsonButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="＋" FontWeight="Bold" Foreground="#E5C478" Margin="0,0,4,0"/>

                                    <TextBlock Text="{Binding Loc_AddItem}" FontSize="11"/>

                                </StackPanel>

                            </Button>

                        </Grid>

                    </Border>



                    <!-- 3. Table Column Headers (Matching KCD2 Screenshot Icons) -->

                    <Border Grid.Row="3" Background="#10131B" BorderBrush="#40C9A24D" BorderThickness="0,0,0,1" Padding="10,6">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="5*" />  <!-- Gegenstand / Kategorie -->

                                <ColumnDefinition Width="1*" />  <!-- Equipped Outfit Slot -->

                                <ColumnDefinition Width="1*" />  <!-- Quantity (#) -->

                                <ColumnDefinition Width="1.2*" />  <!-- Power / Defense -->

                                <ColumnDefinition Width="1.2*" />  <!-- Condition (%) -->

                                <ColumnDefinition Width="1.2*" />  <!-- Weight (lb) -->

                                <ColumnDefinition Width="1.8*" />  <!-- Price (Groschen) -->

                            </Grid.ColumnDefinitions>



                            <TextBlock Grid.Column="0" Text="{Binding Loc_ColItemCategory}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>

                            <TextBlock Grid.Column="1" Text="🛡️" HorizontalAlignment="Center" FontSize="11" ToolTip="{Binding Loc_ColEquippedTip}"/>

                            <TextBlock Grid.Column="2" Text="#" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" FontFamily="Consolas" ToolTip="{Binding Loc_ColQuantityTip}"/>

                            <TextBlock Grid.Column="3" Text="⚔️" HorizontalAlignment="Right" FontSize="11" ToolTip="{Binding Loc_ColPowerTip}"/>

                            <TextBlock Grid.Column="4" Text="❤️" HorizontalAlignment="Right" FontSize="11" ToolTip="{Binding Loc_ColConditionTip}"/>

                            <TextBlock Grid.Column="5" Text="⚖️" HorizontalAlignment="Right" FontSize="11" ToolTip="{Binding Loc_ColWeightTip}"/>

                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">

                                <TextBlock Text="💰" FontSize="11" Margin="0,0,3,0"/>

                                <TextBlock Text="{Binding Loc_ColPrice}" FontSize="11" FontWeight="Bold" Foreground="#C9A24D"/>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- 4. Grouped Inventory List Container -->

                    <ListView Grid.Row="4" ItemsSource="{Binding FilteredInventory}" SelectedItem="{Binding SelectedInventoryItem}"

                              Background="#0F1219" BorderThickness="0" Foreground="#E2E8F0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">



                        <!-- ItemContainerStyle with Prototype Row Selection -->

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">

                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="BorderThickness" Value="3,0,0,0"/>

                                <Setter Property="BorderBrush" Value="Transparent"/>

                                <Setter Property="Padding" Value="10,5"/>

                                <Setter Property="Margin" Value="0,1"/>

                                <Setter Property="Cursor" Value="Hand"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListViewItem">

                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">

                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="Bd" Property="Background" Value="#1E2430"/>

                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">

                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E5C478"/>

                                                    <Setter TargetName="Bd" Property="Background">

                                                        <Setter.Value>

                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                                                                <GradientStop Color="#3D3219" Offset="0"/>

                                                                <GradientStop Color="#1A1813" Offset="0.7"/>

                                                                <GradientStop Color="#282215" Offset="1"/>

                                                            </LinearGradientBrush>

                                                        </Setter.Value>

                                                    </Setter>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ListView.ItemContainerStyle>



                        <!-- GroupStyle for SubCategory Banners (Schwerter, Fernkampfwaffen, etc.) -->

                        <ListView.GroupStyle>

                            <GroupStyle>

                                <GroupStyle.HeaderTemplate>

                                    <DataTemplate>

                                        <Border Background="#141923" BorderBrush="#352F22" BorderThickness="0,0,0,1" Padding="10,5" Margin="0,4,0,0">

                                            <StackPanel Orientation="Horizontal">

                                                <Rectangle Width="3" Height="14" Fill="#C9A24D" Margin="0,0,8,0" RadiusX="1" RadiusY="1"/>

                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#E5C478" FontSize="12" />

                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="#64748B" FontSize="11" Margin="3,0,0,0" FontFamily="Consolas"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </GroupStyle.HeaderTemplate>

                            </GroupStyle>

                        </ListView.GroupStyle>



                        <!-- Item Template matching Prototype Columns -->

                        <ListView.ItemTemplate>

                            <DataTemplate DataType="{x:Type vm:InventoryItemViewModel}">

                                <Grid Margin="0,2">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="5*" />

                                        <ColumnDefinition Width="1*" />

                                        <ColumnDefinition Width="1*" />

                                        <ColumnDefinition Width="1.2*" />

                                        <ColumnDefinition Width="1.2*" />

                                        <ColumnDefinition Width="1.2*" />

                                        <ColumnDefinition Width="1.8*" />

                                    </Grid.ColumnDefinitions>



                                    <!-- Item Name + Tier Badge + UUID + Stolen Flag -->

                                    <StackPanel Grid.Column="0" Orientation="Vertical">

                                        <StackPanel Orientation="Horizontal">

                                            <!-- Tier Badge (I, II, III, M) -->

                                            <Border Background="#25C9A24D" BorderBrush="#60C9A24D" BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="0,0,5,0"

                                                    Visibility="{Binding Tier, Converter={StaticResource IntGtZeroToVis}}">

                                                <TextBlock Text="{Binding TierDisplay}" FontSize="9" FontWeight="Bold" Foreground="#E5C478" FontFamily="Consolas"/>

                                            </Border>



                                            <!-- Storage Badge (Henry / Stash / Horse) -->

                                            <Border Background="{Binding StorageBadgeBackground}" BorderBrush="{Binding StorageBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="{Binding StorageLocationName}">

                                                <TextBlock Text="{Binding StorageLocationBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding StorageBadgeForeground}" FontFamily="Consolas"/>

                                            </Border>



                                            <!-- Stolen Hand Badge -->

                                            <Border Background="#408C1D24" BorderBrush="#8C1D24" BorderThickness="1" CornerRadius="3" Padding="3,0" Margin="0,0,5,0"

                                                    Visibility="{Binding IsStolen, Converter={StaticResource BoolToVis}}" ToolTip="{Binding DataContext.Loc_StolenTooltip, RelativeSource={RelativeSource AncestorType=Window}}">

                                                <TextBlock Text="✋" FontSize="9"/>

                                            </Border>



                                            <TextBlock Text="{Binding ItemUiName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>

                                        </StackPanel>

                                        <TextBlock Text="{Binding ShortUuid}" FontSize="9" Foreground="#64748B" FontFamily="Consolas"/>

                                    </StackPanel>



                                    <!-- Equipped Outfit Shield + Blood Droplet -->

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <Border Width="16" Height="16" CornerRadius="3" Background="#1E3A2F" BorderBrush="#34D399" BorderThickness="1"

                                                Visibility="{Binding IsEquipped, Converter={StaticResource BoolToVis}}" ToolTip="{Binding DataContext.Loc_EquippedTooltip, RelativeSource={RelativeSource AncestorType=Window}}">

                                            <TextBlock Text="🛡️" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <TextBlock Text="🩸" FontSize="10" Margin="3,0,0,0" Visibility="{Binding HasBlood, Converter={StaticResource BoolToVis}}" ToolTip="{Binding DataContext.Loc_BloodyTooltip, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                    </StackPanel>



                                    <!-- Quantity (#) -->

                                    <TextBlock Grid.Column="2" Text="{Binding FormattedAmount}" HorizontalAlignment="Center" VerticalAlignment="Center"

                                               FontWeight="Bold" Foreground="#F1F5F9" FontSize="12" FontFamily="Consolas"/>



                                    <!-- Power / Defense -->

                                    <TextBlock Grid.Column="3" Text="{Binding FormattedPower}" HorizontalAlignment="Right" VerticalAlignment="Center"

                                               FontWeight="Bold" Foreground="#CBD5E1" FontSize="11" FontFamily="Consolas"/>



                                    <!-- Condition (%) -->

                                    <TextBlock Grid.Column="4" Text="{Binding ConditionPercent, StringFormat='{}{0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center"

                                               FontWeight="Bold" Foreground="{Binding ConditionColor}" FontSize="11" FontFamily="Consolas"/>



                                    <!-- Weight -->

                                    <TextBlock Grid.Column="5" Text="{Binding FormattedWeight}" HorizontalAlignment="Right" VerticalAlignment="Center"

                                               Foreground="#94A3B8" FontSize="11" FontFamily="Consolas"/>



                                    <!-- Price in Groschen -->

                                    <TextBlock Grid.Column="6" Text="{Binding FormattedPrice}" HorizontalAlignment="Right" VerticalAlignment="Center"

                                               FontWeight="Bold" Foreground="#E5C478" FontSize="11" FontFamily="Consolas"/>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>



                    <!-- 5. LIVE ITEM INSPECTOR & HEX-EDITOR DRAWER -->

                    <Border Grid.Row="5" Background="#151923" BorderBrush="#40C9A24D" BorderThickness="0,1,0,0" Padding="12,10"

                            Visibility="{Binding SelectedInventoryItem, Converter={StaticResource NullToVis}}">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" /> <!-- Header -->

                                <RowDefinition Height="Auto" /> <!-- Sliders & Inputs -->

                                <RowDefinition Height="Auto" /> <!-- Actions & Toggles -->

                            </Grid.RowDefinitions>



                            <!-- Inspector Header -->

                            <Grid Grid.Row="0" Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>



                                <StackPanel Grid.Column="0" Orientation="Horizontal">

                                    <TextBlock Text="✦ " Foreground="#C9A24D" FontSize="12"/>

                                    <TextBlock Text="{Binding SelectedInventoryItem.ItemUiName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" TextTrimming="CharacterEllipsis"/>

                                    <Border Background="{Binding SelectedInventoryItem.StorageBadgeBackground}" BorderBrush="{Binding SelectedInventoryItem.StorageBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">

                                        <TextBlock Text="{Binding SelectedInventoryItem.StorageLocationName}" FontSize="10" FontWeight="Bold" Foreground="{Binding SelectedInventoryItem.StorageBadgeForeground}"/>

                                    </Border>

                                    <Border Background="#25C9A24D" BorderBrush="#50C9A24D" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="8,0,0,0"

                                            Visibility="{Binding SelectedInventoryItem.Tier, Converter={StaticResource IntGtZeroToVis}}">

                                        <TextBlock Text="{Binding SelectedInventoryItem.TierDisplay, StringFormat='Tier {0}'}" FontSize="10" FontWeight="Bold" Foreground="#E5C478" FontFamily="Consolas"/>

                                    </Border>

                                </StackPanel>



                                <StackPanel Grid.Column="1" Orientation="Horizontal">

                                    <TextBlock Text="ID: " Foreground="#64748B" FontSize="10"/>

                                    <TextBlock Text="{Binding SelectedInventoryItem.ItemId}" Foreground="#94A3B8" FontSize="10" FontFamily="Consolas"/>

                                </StackPanel>

                            </Grid>



                            <!-- Sliders & Numeric Inputs (2 Columns) -->

                            <Grid Grid.Row="1" Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="12" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>



                                <!-- Left Sub-Column: Condition & Blood Sliders -->

                                <StackPanel Grid.Column="0">

                                    <!-- Condition Slider -->

                                    <Grid Margin="0,0,0,6">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="45" />

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc_InspectorCondition}" Foreground="#94A3B8" FontSize="11" Width="80" VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SelectedInventoryItem.ConditionPercentInt, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding SelectedInventoryItem.ConditionPercentInt, StringFormat='{}{0}%'}" Foreground="{Binding SelectedInventoryItem.ConditionColor}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>

                                    </Grid>



                                    <!-- Blood / Dirt Slider -->

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="45" />

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Loc_InspectorBlood}" Foreground="#94A3B8" FontSize="11" Width="80" VerticalAlignment="Center"/>

                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SelectedInventoryItem.Blood, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding SelectedInventoryItem.Blood, StringFormat='{}{0}%'}" Foreground="#FB7185" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>

                                    </Grid>

                                </StackPanel>



                                <!-- Right Sub-Column: Amount, Power, Weight, Price Inputs -->

                                <Grid Grid.Column="2">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="8" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="8" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="8" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>



                                    <!-- Menge -->

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="{Binding Loc_InspectorAmount}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>

                                        <TextBox Text="{Binding SelectedInventoryItem.Amount, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center"/>

                                    </StackPanel>



                                    <!-- Power -->

                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="{Binding Loc_InspectorPower}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>

                                        <TextBox Text="{Binding SelectedInventoryItem.Power, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontWeight="Bold" Foreground="#CBD5E1" TextAlignment="Center"/>

                                    </StackPanel>



                                    <!-- Weight -->

                                    <StackPanel Grid.Column="4">

                                        <TextBlock Text="{Binding Loc_InspectorWeight}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,2"/>

                                        <TextBox Text="{Binding SelectedInventoryItem.Weight, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0.0}'}" FontFamily="Consolas" Foreground="#CBD5E1" TextAlignment="Center"/>

                                    </StackPanel>



                                    <!-- Price -->

                                    <StackPanel Grid.Column="6">

                                        <TextBlock Text="{Binding Loc_InspectorPrice}" FontSize="10" Foreground="#C9A24D" Margin="0,0,0,2"/>

                                        <TextBox Text="{Binding SelectedInventoryItem.Price, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="#E5C478" TextAlignment="Center"/>

                                    </StackPanel>

                                </Grid>

                            </Grid>



                            <!-- Actions & Toggles Row -->

                            <Grid Grid.Row="2">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>



                                <!-- Outfits & Stolen Flag -->

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Loc_InspectorEquipment}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <CheckBox Content="{Binding Loc_InspectorOutfit1}" IsChecked="{Binding SelectedInventoryItem.Outfit1}" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <CheckBox Content="{Binding Loc_InspectorOutfit2}" IsChecked="{Binding SelectedInventoryItem.Outfit2}" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <CheckBox Content="{Binding Loc_InspectorOutfit3}" IsChecked="{Binding SelectedInventoryItem.Outfit3}" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                    <CheckBox Content="{Binding Loc_InspectorStolen}" IsChecked="{Binding SelectedInventoryItem.IsStolen}" Foreground="#FB7185" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>

                                </StackPanel>



                                <!-- Quick Move & Duplicate & Delete Buttons -->

                                <StackPanel Grid.Column="1" Orientation="Horizontal">

                                    <Button Command="{Binding SelectedInventoryItem.MoveToStashCommand}"

                                            Content="{Binding DataContext.Loc_MoveToStash, RelativeSource={RelativeSource AncestorType=Window}}"

                                            Visibility="{Binding SelectedInventoryItem.IsInInventory, Converter={StaticResource BoolToVis}}"

                                            Style="{StaticResource DarkUtilityButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>

                                    <Button Command="{Binding SelectedInventoryItem.MoveToInventoryCommand}"

                                            Content="{Binding DataContext.Loc_TakeToInventory, RelativeSource={RelativeSource AncestorType=Window}}"

                                            Visibility="{Binding SelectedInventoryItem.IsInStash, Converter={StaticResource BoolToVis}}"

                                            Style="{StaticResource GoldButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>

                                    <Button Command="{Binding SelectedInventoryItem.MoveToInventoryCommand}"

                                            Content="{Binding DataContext.Loc_TakeToInventory, RelativeSource={RelativeSource AncestorType=Window}}"

                                            Visibility="{Binding SelectedInventoryItem.IsInHorse, Converter={StaticResource BoolToVis}}"

                                            Style="{StaticResource GoldButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>

                                    <Button Command="{Binding DuplicateSelectedItemCommand}" Content="{Binding Loc_InspectorDuplicate}" Style="{StaticResource DarkUtilityButton}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>

                                    <Button Command="{Binding DeleteSelectedItemCommand}" Content="{Binding Loc_InspectorDelete}" Style="{StaticResource CrimsonButton}" Padding="8,3" FontSize="11"/>

                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Border>



                    <!-- 6. INVENTORY FOOTER: GROSCHEN & TRAGLAST BAR -->

                    <Border Grid.Row="6" BorderBrush="#40C9A24D" BorderThickness="0,1,0,0" Padding="12,8">

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

                                <GradientStop Color="#231114" Offset="0"/>

                                <GradientStop Color="#1A1318" Offset="0.5"/>

                                <GradientStop Color="#231114" Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>



                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>



                            <!-- Groschen Editor -->

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                <TextBlock Text="✦ " Foreground="#C9A24D" VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Loc_FooterGroschen}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <Border Background="#10000000" BorderBrush="#60C9A24D" BorderThickness="1" CornerRadius="6" Padding="6,2">

                                    <TextBox Text="{Binding Groschen, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Foreground="#E5C478" Width="100" Background="Transparent" BorderThickness="0"/>

                                </Border>

                                <Button Content="+10k" Command="{Binding AddGroschenCommand}" CommandParameter="10000" Style="{StaticResource DarkUtilityButton}" Margin="6,0,4,0" Padding="6,2" FontSize="10"/>

                                <Button Content="Max 999k" Command="{Binding MaxMoneyCommand}" Style="{StaticResource DarkUtilityButton}" Padding="6,2" FontSize="10"/>

                            </StackPanel>



                            <!-- Traglast (Weight / Capacity) -->

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                <TextBlock Text="{Binding Loc_FooterCarryWeight}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <Border Background="#10000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,3">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding CarryWeight, StringFormat='{}{0:0}'}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" FontFamily="Consolas"/>

                                        <TextBlock Text=" / " Foreground="#64748B" FontSize="12" FontFamily="Consolas"/>

                                        <TextBox Text="{Binding MaxCarryWeight, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0}'}" Foreground="#E5C478" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Width="40" Background="Transparent" BorderThickness="0" TextAlignment="Center"/>

                                        <TextBlock Text=" kg" Foreground="#94A3B8" FontSize="11"/>

                                    </StackPanel>

                                </Border>

                                <TextBlock Text=" ✦" Foreground="#C9A24D" VerticalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </Border>

